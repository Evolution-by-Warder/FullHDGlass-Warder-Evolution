#!/bin/sh
set -u

# During a package upgrade the old package's postrm may be called after the
# new files are unpacked. Never run removal cleanup in that case.
case "${1:-}" in
    remove|purge) ;;
    *) exit 0 ;;
esac

SCREENPATH=/usr/lib/enigma2/python/Screens
CHANSEL="$SCREENPATH/ChannelSelection.py"
MENU="$SCREENPATH/Menu.py"

restore_backup() {
    backup="$1"
    target="$2"
    if [ -f "$backup" ]; then
        cp -f "$backup" "$target"
        rm -f "$backup"
    fi
}

# Restore only files for which FullHDGlass17 created an explicit backup.
restore_backup /etc/enigma2/skin_user-ori17.xml /etc/enigma2/skin_user.xml
restore_backup /usr/share/enigma2/encoding-ori17.conf /usr/share/enigma2/encoding.conf
restore_backup "$CHANSEL"-ori17.py "$CHANSEL"
restore_backup "$MENU"-orig17.py "$MENU"
restore_backup "$MENU"-orig17.pyc "$MENU".pyc
restore_backup "$MENU"-orig17.pyo "$MENU".pyo

# A full removal clears only Warder's migration state; upgrades exit above.
WARDER_EPG_STATE_DIR=/var/lib/fullhdglass17
rm -f "$WARDER_EPG_STATE_DIR/epg-default-v1.state" "$WARDER_EPG_STATE_DIR/epg-default-v1.state.tmp."* 2>/dev/null || true
# Transition snapshots created by prerm are private package state, not
# user configuration. Restore of receiver-owned files is handled above.
WARDER_TRANSITION="$WARDER_EPG_STATE_DIR/package-transition-v1"
if [ -d "$WARDER_TRANSITION" ] && [ ! -L "$WARDER_TRANSITION" ]; then
    rm -rf -- "$WARDER_TRANSITION"
fi
rmdir "$WARDER_EPG_STATE_DIR" 2>/dev/null || true

# Uninstallation also removes the skin's *own* downloaded data tree.
# PATHS stores its parent in Enigma2 settings; par39 is a runtime-only value.
# Never delete the parent: it can contain picons or data from other plugins.
warder_setting() {
    key="$1"
    [ -f /etc/enigma2/settings ] || return 0
    awk -v key="$key" '
        index($0, key "=") == 1 {
            print substr($0, length(key) + 2)
            exit
        }
    ' /etc/enigma2/settings
}

warder_remove_data_tree() {
    base="$1"
    [ -n "$base" ] || return 0
    # Reject special chars, traversal, and paths outside known storage roots.
    case "$base" in
        *[!a-zA-Z0-9_./\ -]*|*'/../'*|*'/./'*|*'//'*) return 1 ;;
    esac
    case "$base" in
        /media/usb|/media/hdd|/media/cf|/media/sdcard|/media/mmc|/data|/usr/share/enigma2|/etc|/media/*|/mnt/*) ;;
        *) return 1 ;;
    esac
    dir="${base%/}/hdg17_files"
    [ -e "$dir" ] || [ -L "$dir" ] || return 0
    # A symlink or mounted data tree is never treated as Warder-owned files.
    [ -L "$dir" ] && return 1
    [ -d "$dir" ] || return 1
    parent="$dir"
    while [ "$parent" != "/" ]; do
        [ -L "$parent" ] && return 1
        parent=${parent%/*}
        [ -n "$parent" ] || parent=/
    done
    if [ -r /proc/self/mountinfo ] && awk -v d="$dir" '
        {
            mount = $5
            gsub(/\\040/, " ", mount)
            if (mount == d || index(mount, d "/") == 1) found = 1
        }
        END { exit !found }
    ' /proc/self/mountinfo; then
        echo "WARNING: mounted storage within $dir; skipping unsafe cleanup" >&2
        return 1
    fi
    rm -rf -- "$dir"
}

warder_cleanup_downloaded_data() {
    selected="$(warder_setting config.plugins.setupGlass17.par125)"
    user_base="$(warder_setting config.plugins.setupGlass17.par124)"
    [ -n "$selected" ] || selected=/media/usb
    if [ "$selected" = 0 ]; then
        base="$user_base"
    else
        base="$selected"
    fi
    # The active location, not every drive on the receiver, is ours to clean.
    warder_remove_data_tree "$base" || echo "WARNING: could not safely remove Warder data at $base" >&2
}

# Remove all remaining data under package-exclusive installation directories.
# opkg normally removes tracked files but leaves untracked/generated files.
# This runs ONLY on genuine remove/purge (never on upgrade, see guard above).
# Never follow a symlink or cross a nested mount: that could delete a user's HDD.
warder_remove_install_dir() {
    dir="$1"
    case "$dir" in
        /usr/share/enigma2/hd_glass17|/usr/lib/enigma2/python/Plugins/Extensions/setupGlass17|/var/lib/fullhdglass17) ;;
        *) return 1 ;;
    esac
    [ -e "$dir" ] || [ -L "$dir" ] || return 0
    if [ -L "$dir" ]; then
        # Only remove the link, never its target.
        rm -f -- "$dir" || return 1
        return 0
    fi
    [ -d "$dir" ] || return 1
    # Avoid deleting data behind bind mounts or mounted external media.
    if [ -r /proc/self/mountinfo ] && awk -v d="$dir" '
        {
            mount = $5
            gsub(/\\040/, " ", mount)
            if (mount == d || index(mount, d "/") == 1) found = 1
        }
        END { exit !found }
    ' /proc/self/mountinfo; then
        echo "ERROR: mounted data under $dir; refusing recursive removal" >&2
        return 1
    fi
    # Guard every ancestor: a symlinked parent could redirect the removal.
    parent="$dir"
    while [ "$parent" != "/" ]; do
        parent=${parent%/*}
        [ -n "$parent" ] || parent=/
        if [ -L "$parent" ]; then
            echo "ERROR: symlinked parent $parent; refusing deletion" >&2
            return 1
        fi
    done
    rm -rf -- "$dir" || return 1
    if [ -e "$dir" ] || [ -L "$dir" ]; then
        echo "ERROR: installation directory still exists: $dir" >&2
        return 1
    fi
}

case "${1:-}" in
    remove|purge)
        warder_cleanup_downloaded_data
        warder_remove_install_dir /usr/share/enigma2/hd_glass17 || exit 1
        warder_remove_install_dir /usr/lib/enigma2/python/Plugins/Extensions/setupGlass17 || exit 1
        warder_remove_install_dir /var/lib/fullhdglass17 || exit 1
        ;;
esac

# Do not remove /etc/enigma2/settings. Saved Enigma2 and FullHDGlass17
# preferences remain user data even when the skin package is removed.
# Do not delete broad wildcards from Enigma2 system directories here;
# the package manager removes files that belong to this package itself.
echo "***************************************"
echo "FullHDGlass removal finished."
echo "Saved Enigma2 settings were left intact."
echo "Please restart GUI to activate changes."
echo "***************************************"
exit 0
