#!/bin/sh
set -u

WARDER_PACKAGE_ID=enigma2-plugin-skins-fullhdglass-warder-evolution
# opkg/libsolv treats a differently named replacement as an upgrade and calls
# this preinst before the old postrm. The owner-supplied r12.2 postrm exits
# immediately for upgrade. Admit only that exact, verified hook and invocation;
# an unknown legacy remover still requires the existing prepared transition.
warder_verified_r12_upgrade() {
    [ "${1:-}" = upgrade ] && [ "${2:-}" = 9.50-r12.2 ] || return 1
    for warder_info in /var/lib/opkg/info /usr/lib/opkg/info; do
        warder_old_postrm="$warder_info/enigma2-skin-fullhdglass17.postrm"
        warder_old_prerm="$warder_info/enigma2-skin-fullhdglass17.prerm"
        if [ -f "$warder_old_postrm" ] && [ ! -L "$warder_old_postrm" ] &&
           [ ! -e "$warder_old_prerm" ] && [ ! -L "$warder_old_prerm" ] &&
           [ "$(sha256sum "$warder_old_postrm" 2>/dev/null | awk '{print $1}')" = d830f49a50c719a877aeb059c2f62e04105db1d3d9affbe467f8d2ae2788731d ]; then
            return 0
        fi
    done
    return 1
}
if [ "$WARDER_PACKAGE_ID" = enigma2-plugin-skins-fullhdglass-warder-evolution ] && command -v opkg >/dev/null 2>&1; then
    if opkg status enigma2-skin-fullhdglass17 2>/dev/null | awk '$1 == "Package:" { package = $2 } /^Status:/ { if (package == "enigma2-skin-fullhdglass17" && $NF == "installed") found = 1 } END { exit !found }' &&
       [ ! -f /var/lib/fullhdglass17/package-transition-v1/manifest.json ] &&
       ! warder_verified_r12_upgrade "$@"; then
        echo "This legacy installation needs a verified transition before replacing it."
        exit 1
    fi
fi

echo "******************************************************************"
echo "*              FullHDGlass - Warder Evolution                 *"
echo "******************************************************************"

# Record whether this package manager invocation is a first install or upgrade.
# Only an explicit first-install context may seed the Warder EPG hotkey.
WARDER_EPG_STATE_DIR=/var/lib/fullhdglass17
WARDER_EPG_STATE_FILE="$WARDER_EPG_STATE_DIR/epg-default-v1.state"
warder_epg_state=$(cat "$WARDER_EPG_STATE_FILE" 2>/dev/null || true)
warder_write_epg_state() {
    state_value="$1"
    state_tmp="$WARDER_EPG_STATE_FILE.tmp.$$"
    if mkdir -p "$WARDER_EPG_STATE_DIR" 2>/dev/null &&
       printf '%s\n' "$state_value" > "$state_tmp" 2>/dev/null &&
       mv -f "$state_tmp" "$WARDER_EPG_STATE_FILE" 2>/dev/null; then
        return 0
    fi
    rm -f "$state_tmp" 2>/dev/null || true
    return 1
}
case "${1:-}" in
    install)
        if [ ! -e "$WARDER_EPG_STATE_FILE" ]; then
            warder_write_epg_state fresh-pending || true
        fi
        ;;
    upgrade)
        if [ "$warder_epg_state" != "done" ]; then
            warder_write_epg_state preserve-pending || true
        fi
        ;;
    *)
        # Unknown/abort states fail closed: never infer that they are fresh.
        if [ "$warder_epg_state" != "done" ] && [ "$warder_epg_state" != "preserve-pending" ]; then
            warder_write_epg_state preserve-pending || true
        fi
        ;;
esac

# Preserve the generated FullHDGlass17 user overlay across upgrades.
# The main Enigma2 configuration lives in /etc/enigma2/settings and is
# deliberately never modified by this package.
if [ -f /etc/enigma2/skin_user-hdg17.xml ]; then
    cp -pf /etc/enigma2/skin_user-hdg17.xml /tmp/skin_user-hdg17.xml.warder-upgrade 2>/dev/null || true
fi

for f in /usr/share/enigma2/skin_default.xml /usr/share/enigma2/skin.xml /usr/share/enigma2/skin_default/skin.xml /usr/share/enigma2/skin_default_*.xml; do
    if [ -f "$f" ] && grep -Eq 'parameters|alias' "$f"; then
        echo "Image version looks compatible."
        exit 0
    fi
done

if [ -d /usr/lib/enigma2/python ] && [ -d /usr/share/enigma2 ]; then
    echo "Enigma2 runtime detected; allowing installation on DreamOS-compatible layout."
    exit 0
fi

echo "Unsupported Enigma2 installation detected; installation aborted."
exit 1
