#!/bin/sh
set -u

WARDER_PACKAGE_ID=enigma2-plugin-skins-fullhdglass-warder-evolution
# The original installer deletes these two payload files but leaves them in
# its opkg file list. Restore only missing, explicitly tracked legacy entries
# so opkg can prune them without ENOENT. Never overwrite files or symlinks.
warder_prepare_legacy_obsolete_files() {
    warder_old_list="$1/enigma2-skin-fullhdglass17.list"
    [ -f "$warder_old_list" ] && [ ! -L "$warder_old_list" ] || return 0
    for warder_obsolete in /tmp/plugin-17.py /usr/lib/enigma2/python/Screens/Menu-new17-38.py; do
        if awk -v path="$warder_obsolete" '$1 == path { found = 1 } END { exit !found }' "$warder_old_list" &&
           [ ! -e "$warder_obsolete" ] && [ ! -L "$warder_obsolete" ]; then
            (set -C; umask 077; : > "$warder_obsolete") || return 2
            echo "Prepared obsolete legacy entry: $warder_obsolete"
        fi
    done
    return 0
}
# opkg/libsolv uses the original FullHDGlass postrm after the new preinst.
# Upgrade is safe only after the old removal hook has been guarded. Accept the
# 9.50 revision family, but never run an unreviewed remover during replacement.
# An unrecognised hook is wrapped unchanged for genuine remove operations; only
# upgrade-family operations are intercepted. Preserve original bytes separately.
warder_verified_r12_upgrade() {
    [ "${1:-}" = upgrade ] || return 1
    case "${2:-}" in 9.50|9.50-*) ;; *) return 1 ;; esac
    for warder_info in /var/lib/opkg/info /usr/lib/opkg/info; do
        warder_old_postrm="$warder_info/enigma2-skin-fullhdglass17.postrm"
        warder_old_prerm="$warder_info/enigma2-skin-fullhdglass17.prerm"
        [ -f "$warder_old_postrm" ] && [ ! -L "$warder_old_postrm" ] || continue
        # If an unknown prerm is installed, it can run before this preinst;
        # do not claim that the legacy transition is protected.
        [ ! -e "$warder_old_prerm" ] && [ ! -L "$warder_old_prerm" ] || return 1
        [ -s "$warder_old_postrm" ] && [ -r "$warder_old_postrm" ] || return 1
        IFS= read -r warder_first_line < "$warder_old_postrm" || return 1
        case "$warder_first_line" in '#!'*/sh|'#!'*/bash) ;; *) return 1 ;; esac
        # The original remover stays intact as a forensic fallback. Do not
        # alter /var/lib/opkg/status or any actual receiver configuration.
        warder_old_backup="$warder_old_postrm.warder-original"
        if [ -e "$warder_old_backup" ] || [ -L "$warder_old_backup" ]; then
            [ -f "$warder_old_backup" ] && [ ! -L "$warder_old_backup" ] || return 1
            # A repeated transaction is safe only if the installed script
            # already has our exact upgrade guard marker.
            grep -q '^# Warder legacy 9.50 upgrade guard v2$' "$warder_old_postrm" || return 1
        else
            warder_hook_tmp="$warder_old_postrm.warder-guard.$$"
            warder_backup_tmp="$warder_old_backup.tmp.$$"
            if ! (umask 077; cp -p "$warder_old_postrm" "$warder_backup_tmp"); then
                rm -f "$warder_backup_tmp"
                return 1
            fi
            if ! (umask 022; {
                printf '%s\n' '#!/bin/sh' '# Warder legacy 9.50 upgrade guard v2' \
                    'case "${1:-}" in upgrade|failed-upgrade|abort-upgrade|disappear) exit 0 ;; esac'
                cat "$warder_backup_tmp"
            } > "$warder_hook_tmp"); then
                rm -f "$warder_hook_tmp" "$warder_backup_tmp"
                return 1
            fi
            if ! sh -n "$warder_hook_tmp"; then
                rm -f "$warder_hook_tmp" "$warder_backup_tmp"
                return 1
            fi
            chmod 755 "$warder_hook_tmp" || return 1
            # Write the backup first so failed installation can be audited.
            if ! mv -f "$warder_backup_tmp" "$warder_old_backup"; then
                rm -f "$warder_hook_tmp" "$warder_backup_tmp"
                return 1
            fi
            if ! mv -f "$warder_hook_tmp" "$warder_old_postrm"; then
                return 1
            fi
        fi
        warder_prepare_legacy_obsolete_files "$warder_info"
        return $?
    done
    return 1
}
if [ "$WARDER_PACKAGE_ID" = enigma2-plugin-skins-fullhdglass-warder-evolution ]; then
    # This preparation must not be short-circuited by a retained transition
    # manifest or by a nested status query during the parent opkg invocation.
    warder_upgrade_prepared=0
    if warder_verified_r12_upgrade "$@"; then
        warder_upgrade_prepared=1
        echo "Verified legacy upgrade preparation completed."
    else
        warder_prepare_result=$?
        if [ "$warder_prepare_result" -eq 2 ]; then
            echo "Could not prepare a tracked obsolete legacy entry. Installation aborted."
            exit 1
        fi
    fi
    if command -v opkg >/dev/null 2>&1 &&
       opkg status enigma2-skin-fullhdglass17 2>/dev/null | awk '$1 == "Package:" { package = $2 } /^Status:/ { if (package == "enigma2-skin-fullhdglass17" && $NF == "installed") found = 1 } END { exit !found }' &&
       [ ! -f /var/lib/fullhdglass17/package-transition-v1/manifest.json ] &&
       [ "$warder_upgrade_prepared" -ne 1 ]; then
        echo "This legacy installation needs a verified transition before replacing it."
        exit 1
    fi
fi

echo "******************************************************************"
echo "*              FullHDGlass - Warder Evolution                 *"
echo "******************************************************************"

# Record whether this package manager invocation is a first install or upgrade.
# Only an explicit first-install context may seed the Warder EPG hotkey.
WARDER_EPG_STATE_DIR=/var/lib/fullhdglass17
WARDER_EPG_STATE_FILE="$WARDER_EPG_STATE_DIR/epg-default-v1.state"
warder_epg_state=$(cat "$WARDER_EPG_STATE_FILE" 2>/dev/null || true)
warder_write_epg_state() {
    state_value="$1"
    state_tmp="$WARDER_EPG_STATE_FILE.tmp.$$"
    if mkdir -p "$WARDER_EPG_STATE_DIR" 2>/dev/null &&
       printf '%s\n' "$state_value" > "$state_tmp" 2>/dev/null &&
       mv -f "$state_tmp" "$WARDER_EPG_STATE_FILE" 2>/dev/null; then
        return 0
    fi
    rm -f "$state_tmp" 2>/dev/null || true
    return 1
}
case "${1:-}" in
    install)
        if [ ! -e "$WARDER_EPG_STATE_FILE" ]; then
            warder_write_epg_state fresh-pending || true
        fi
        ;;
    upgrade)
        if [ "$warder_epg_state" != "done" ]; then
            warder_write_epg_state preserve-pending || true
        fi
        ;;
    *)
        # Unknown/abort states fail closed: never infer that they are fresh.
        if [ "$warder_epg_state" != "done" ] && [ "$warder_epg_state" != "preserve-pending" ]; then
            warder_write_epg_state preserve-pending || true
        fi
        ;;
esac

# Preserve the generated FullHDGlass17 user overlay across upgrades.
# The main Enigma2 configuration lives in /etc/enigma2/settings and is
# deliberately never modified by this package.
if [ -f /etc/enigma2/skin_user-hdg17.xml ]; then
    cp -pf /etc/enigma2/skin_user-hdg17.xml /tmp/skin_user-hdg17.xml.warder-upgrade 2>/dev/null || true
fi

for f in /usr/share/enigma2/skin_default.xml /usr/share/enigma2/skin.xml /usr/share/enigma2/skin_default/skin.xml /usr/share/enigma2/skin_default_*.xml; do
    if [ -f "$f" ] && grep -Eq 'parameters|alias' "$f"; then
        echo "Image version looks compatible."
        exit 0
    fi
done

if [ -d /usr/lib/enigma2/python ] && [ -d /usr/share/enigma2 ]; then
    echo "Enigma2 runtime detected; allowing installation on DreamOS-compatible layout."
    exit 0
fi

echo "Unsupported Enigma2 installation detected; installation aborted."
exit 1
