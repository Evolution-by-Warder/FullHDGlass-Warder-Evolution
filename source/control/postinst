#!/bin/sh
set -u

# Restore the pre-removal snapshot before reading migration/default state.
/usr/bin/python3 /usr/lib/enigma2/python/Plugins/Extensions/setupGlass17/warderPackageTransition.py restore || exit 1

copy_default_if_missing() {
    src="$1"
    dst="$2"
    if [ -f "$src" ] && [ ! -e "$dst" ]; then
        cp -f "$src" "$dst"
    fi
}

# Restore the user's generated FullHDGlass17 overlay after an upgrade.
# /etc/enigma2/settings and /etc/enigma2/skin_user.xml are intentionally
# not package-owned and are left untouched, preserving all saved choices
# including the currently selected skin.
if [ -f /tmp/skin_user-hdg17.xml.warder-upgrade ]; then
    cp -pf /tmp/skin_user-hdg17.xml.warder-upgrade /etc/enigma2/skin_user-hdg17.xml 2>/dev/null || true
    rm -f /tmp/skin_user-hdg17.xml.warder-upgrade
fi

# Apply this default only when preinst explicitly recorded a first install.
# Upgrades, repeat configure calls, and unknown states preserve user settings.
WARDER_EPG_STATE_DIR=/var/lib/fullhdglass17
WARDER_EPG_STATE_FILE="$WARDER_EPG_STATE_DIR/epg-default-v1.state"
WARDER_EPG_SETTINGS=/etc/enigma2/settings
warder_epg_state=$(cat "$WARDER_EPG_STATE_FILE" 2>/dev/null || true)
warder_write_epg_state() {
    state_value="$1"
    state_tmp="$WARDER_EPG_STATE_FILE.tmp.$$"
    if mkdir -p "$WARDER_EPG_STATE_DIR" 2>/dev/null &&
       printf '%s\n' "$state_value" > "$state_tmp" 2>/dev/null &&
       mv -f "$state_tmp" "$WARDER_EPG_STATE_FILE" 2>/dev/null; then
        return 0
    fi
    rm -f "$state_tmp" 2>/dev/null || true
    return 1
}
case "$warder_epg_state" in
    fresh-pending)
        if [ -e "$WARDER_EPG_SETTINGS" ] && [ ! -f "$WARDER_EPG_SETTINGS" ]; then
            echo "Warder EPG default skipped: settings path is not a regular file."
        elif grep -q '^config.misc.ButtonSetup.epg=' "$WARDER_EPG_SETTINGS" 2>/dev/null; then
            echo "Warder EPG default preserved: an explicit EPG hotkey already exists."
            warder_write_epg_state done || true
        else
            if [ ! -e "$WARDER_EPG_SETTINGS" ]; then
                (umask 077; : > "$WARDER_EPG_SETTINGS") 2>/dev/null || true
            fi
            if [ -f "$WARDER_EPG_SETTINGS" ]; then
                if [ -s "$WARDER_EPG_SETTINGS" ]; then
                    last_byte=$(tail -c 1 "$WARDER_EPG_SETTINGS" 2>/dev/null || true)
                    [ -z "$last_byte" ] || printf '\n' >> "$WARDER_EPG_SETTINGS"
                fi
                if printf '%s\n' 'config.misc.ButtonSetup.epg=Infobar/openGraphEPG' >> "$WARDER_EPG_SETTINGS"; then
                    echo "Warder EPG fresh-install default: Infobar/openGraphEPG."
                    warder_write_epg_state done || true
                else
                    echo "Warder EPG default could not be saved; install state remains pending."
                fi
            else
                echo "Warder EPG default skipped: settings file could not be created."
            fi
        fi
        ;;
    preserve-pending)
        echo "Warder EPG setting preserved during package upgrade."
        warder_write_epg_state done || true
        ;;
    done)
        # Idempotent: never seed a setting on later configure/reinstall hooks.
        ;;
    *)
        echo "Warder EPG setting unchanged: no first-install authorization marker."
        ;;
esac

# Install legacy data only when the image does not already provide it.
copy_default_if_missing /usr/share/misc/hddtemp-deff17.db /usr/share/misc/hddtemp.db
copy_default_if_missing /etc/hddtemp-deff17.db /etc/hddtemp.db

# These files are FullHDGlass17 defaults. Keep an existing user/image file intact.
copy_default_if_missing /etc/lcstrings-def17.list /etc/lcstrings.list
copy_default_if_missing /etc/city_Code-17.txt /etc/city_Code.txt
copy_default_if_missing /etc/ewea_city_Code-17.txt /etc/ewea_city_Code.txt
copy_default_if_missing /etc/iptvprov-def17.list /etc/iptvprov.list

# Package identity follows the native OpenATV skins category.
# Runtime paths hd_glass17/setupGlass17 and saved configuration are preserved.

# Remove only the identified temporary GUI observer. Preserve the working
# receiver settings confirmed on test250; do not restore historical test values.
warder_probe=/usr/lib/enigma2/python/Plugins/Extensions/WarderRadioProbe
if [ -d "$warder_probe" ] && [ ! -L "$warder_probe" ] &&
   [ -f "$warder_probe/plugin.py" ] &&
   grep -q '^# WarderRadioProbe diagnostic v1' "$warder_probe/plugin.py"; then
    rm -f "$warder_probe/plugin.py" "$warder_probe/__init__.py" \
          "$warder_probe/plugin.pyc" "$warder_probe/plugin.pyo" \
          "$warder_probe/__init__.pyc" "$warder_probe/__init__.pyo"
    if [ -d "$warder_probe/__pycache__" ] && [ ! -L "$warder_probe/__pycache__" ]; then
        find "$warder_probe/__pycache__" -maxdepth 1 -type f \
          \( -name 'plugin.*.pyc' -o -name '__init__.*.pyc' \) -delete
        rmdir "$warder_probe/__pycache__" 2>/dev/null || true
    fi
    rmdir "$warder_probe" 2>/dev/null || true
fi

# Invalidate bytecode for package-owned plugin modules, including caches made
# from releases with identical timestamps and lengths for changed source code.
warder_python=/usr/lib/enigma2/python/Plugins/Extensions/setupGlass17
if [ -d "$warder_python" ] && [ ! -L "$warder_python" ]; then
    for warder_source in "$warder_python"/*.py; do
        [ -f "$warder_source" ] && [ ! -L "$warder_source" ] || continue
        warder_stem=${warder_source%.py}
        rm -f "$warder_stem.pyc" "$warder_stem.pyo"
        warder_name=${warder_stem##*/}
        if [ -d "$warder_python/__pycache__" ] && [ ! -L "$warder_python/__pycache__" ]; then
            for warder_bytecode in "$warder_python/__pycache__/$warder_name".*.pyc; do
                [ -f "$warder_bytecode" ] && [ ! -L "$warder_bytecode" ] || continue
                rm -f "$warder_bytecode"
            done
        fi
    done
fi

# Apply the selected InfoBar after all package files have been installed.
# Retire only positively identified diagnostic files from older Warder builds.
for warder_log in \
    /tmp/warder-radio-webif-error.log /tmp/warder-radio-webif-hook.log \
    /tmp/warder-radio-artwork.log /tmp/warder-radio-start \
    /tmp/warder-radio-lyrics/.last-result \
    /home/root/logs/warder-infobar-install.log \
    /usr/lib/enigma2/python/Plugins/Extensions/setupGlass17/g17.txt \
    /usr/lib/enigma2/python/Plugins/Extensions/setupGlass17/w17.txt \
    /usr/lib/enigma2/python/Plugins/Extensions/setupGlass17/e17.txt \
    /usr/lib/enigma2/python/Components/Renderer/g17Poster2.log; do
    if [ -f "$warder_log" ] && [ ! -L "$warder_log" ]; then
        rm -f "$warder_log"
    fi
done

if [ -x /usr/bin/python ] && [ -f /usr/lib/enigma2/python/Plugins/Extensions/setupGlass17/warderApplyInfoBar.py ]; then
    /usr/bin/python /usr/lib/enigma2/python/Plugins/Extensions/setupGlass17/warderApplyInfoBar.py / || true
elif [ -x /usr/bin/python3 ] && [ -f /usr/lib/enigma2/python/Plugins/Extensions/setupGlass17/warderApplyInfoBar.py ]; then
    /usr/bin/python3 /usr/lib/enigma2/python/Plugins/Extensions/setupGlass17/warderApplyInfoBar.py / || true
fi

# First radio import runs outside opkg and the GUI, with bounded network time.
# Offline failures stay silent; the session controller retries automatically.
warder_radio_update=/usr/lib/enigma2/python/Plugins/Extensions/setupGlass17/warderRadioUpdate.py
if [ -x /usr/bin/python3 ] && [ -f "$warder_radio_update" ]; then
    /usr/bin/python3 -B "$warder_radio_update" --refresh </dev/null >/dev/null 2>&1 &
fi

# Check files while still in postinst. Fully installed opkg status is checked
# only after opkg exits, because configure has not yet committed that state.
/usr/bin/python3 -B /usr/lib/enigma2/python/Plugins/Extensions/setupGlass17/warderInstallHealth.py --payload-only || exit 1

echo "************************************************"
echo "Install/upgrade finished: FullHDGlass - Warder Evolution"
echo "Existing FullHDGlass settings were preserved."
echo "Please restart GUI to activate changes."
echo "************************************************"
exit 0
