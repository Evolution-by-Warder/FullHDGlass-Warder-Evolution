msgstr "Utiliser l’unité de température définie dans my_city_Code.txt ou city_Code.txt"

msgid "Temperature will be displayed with units defined in eWea_city_Code.txt"
msgstr "Utiliser l’unité de température définie dans eWea_city_Code.txt"

