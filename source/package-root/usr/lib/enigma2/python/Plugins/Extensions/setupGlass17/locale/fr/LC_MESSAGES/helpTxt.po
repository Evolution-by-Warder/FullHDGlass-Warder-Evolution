msgstr "Afficher la position satellite et le nom de la chaîne"

msgid "Show number, satellite position and channel name"
msgstr "Afficher le numéro, la position satellite et le nom de la chaîne"

msgid "None info about \"Provider\" in infobar"
msgstr "Ne pas afficher le fournisseur dans la barre d’informations"

msgid "Show info about \"Provider\" in infobar"
msgstr "Afficher le fournisseur dans la barre d’informations"

msgid "None info about \"Temperature and RPM\" in infobar"
msgstr "Ne pas afficher la température et la vitesse de rotation dans la barre d’informations"

msgid "Show info about \"Temperature and RPM\" in infobar"
msgstr "Afficher la température et la vitesse de rotation dans la barre d’informations"

