msgid "Legacy FullHDGlass custom spinner is retired; the image spinner is preserved"
msgstr "پویانمایی انتظار قدیمی FullHDGlass کنار گذاشته شده است. پویانمایی ایمیج حفظ می‌شود."

msgid "Legacy weather API key (unused; Open-Meteo needs no API key)"
msgstr "کلید قدیمی API هواشناسی استفاده نمی‌شود. Open-Meteo به کلید API نیاز ندارد."

msgid "Legacy weather provider setting is no longer used"
msgstr "تنظیم قدیمی ارائه‌دهندهٔ اطلاعات هواشناسی دیگر استفاده نمی‌شود"

msgid "Please install beautifulsoup4"
msgstr "لطفاً beautifulsoup4 را نصب کنید"

msgid "System spinner provided by the image is used"
msgstr "از پویانمایی انتظار سیستم که همراه ایمیج ارائه شده استفاده می‌شود"

msgid "Weather data is provided by Open-Meteo; no API key is required"
msgstr "داده‌های هواشناسی را Open-Meteo ارائه می‌کند. نیازی به کلید API نیست."

msgid "N/A"
msgstr "در دسترس نیست"

msgid "free"
msgstr "آزاد"

msgid "TP info is not detected"
msgstr "اطلاعات ترانسپوندر شناسایی نشد"

msgid "Reference is not detected"
msgstr "مرجع شناسایی نشد"

msgid "No EPG data available"
msgstr "داده‌های EPG در دسترس نیست"

msgid "Please wait for the reading and processing of data"
msgstr "لطفاً تا پایان خواندن و پردازش داده‌ها صبر کنید"

msgid "Press button \"OK\" to select favorite directory."
msgstr "برای انتخاب پوشهٔ علاقه‌مندی‌ها دکمهٔ \"OK\" را فشار دهید."

msgid "Autocolor - use definition from skin.xml or g17Screens.py; selected color - display with selected color"
msgstr "رنگ خودکار: از تعریف موجود در skin.xml یا g17Screens.py استفاده می‌کند؛ رنگ انتخابی: با رنگ تعیین‌شده نمایش می‌دهد"

msgid "Channels from all satelitte positions and sk/cz terrestrial channels"
msgstr "کانال‌های همهٔ موقعیت‌های ماهواره‌ای و کانال‌های زمینی SK/CZ"

msgid "No plugin Netatmo installed"
msgstr "افزونهٔ Netatmo نصب نشده است"

msgid "Your API-key"
msgstr "کلید API شما"

msgid "The layout is selected automatically calculating by picon size in the infobar"
msgstr "چیدمان بر اساس اندازهٔ پیکون در نوار اطلاعات به‌صورت خودکار محاسبه می‌شود"

msgid "Measurement of current network speed is disabled"
msgstr "اندازه‌گیری سرعت فعلی شبکه غیرفعال است"

msgid "Measurement of current network speed is enabled and is displayed in kb/s"
msgstr "اندازه‌گیری سرعت فعلی شبکه فعال است و مقدار بر حسب kb/s نمایش داده می‌شود"

msgid "Measurement of current network speed is enabled and is displayed in Mb/s"
msgstr "اندازه‌گیری سرعت فعلی شبکه فعال است و مقدار بر حسب Mb/s نمایش داده می‌شود"

msgid "Poster is displayed if exists"
msgstr "پوستر در صورت وجود نمایش داده می‌شود"

msgid "Currently displayed Poster will be erased after press long \"OK\" and do not displayed back again"
msgstr "پوستر فعلی با نگه‌داشتن دکمهٔ \"OK\" حذف می‌شود و دیگر نمایش داده نخواهد شد"

msgid "Poster search from \"Internet Movie Database (IMDb)\""
msgstr "جست‌وجوی پوستر در \"Internet Movie Database (IMDb)\""

msgid "Poster search from \"The Movie Database (TMDb)\""
msgstr "جست‌وجوی پوستر در \"The Movie Database (TMDb)\""

msgid "Poster search from \"Internet Movie Database (IMDb) if not found then search from \"The Movie Database (TMDb)\""
msgstr "ابتدا پوستر را در \"Internet Movie Database (IMDb)\" جست‌وجو کن؛ اگر پیدا نشد، در \"The Movie Database (TMDb)\" جست‌وجو کن"

msgid "Poster search is started with selected delay"
msgstr "جست‌وجوی پوستر پس از تأخیر انتخاب‌شده آغاز می‌شود"

msgid "Poster is displayed with the selected size"
msgstr "پوستر در اندازهٔ انتخاب‌شده نمایش داده می‌شود"

msgid "ECM info is displayed from all channels - current displayed, background recording, streaming etc."
msgstr "اطلاعات ECM همهٔ کانال‌ها، از جمله کانال در حال تماشا، ضبط‌های پس‌زمینه و پخش‌های جریانی، نمایش داده می‌شود"

msgid "ECM info is displayed from current channel"
msgstr "اطلاعات ECM فقط برای کانال فعلی نمایش داده می‌شود"

msgid "Bitrate is calculated by using included bitrate binary"
msgstr "نرخ بیت با استفاده از فایل اجرایی bitrate همراه برنامه محاسبه می‌شود"

msgid "Bitrate is calculated by using eBitrateCalculator from plugin BitrateViewer"
msgstr "نرخ بیت با eBitrateCalculator در افزونهٔ BitrateViewer محاسبه می‌شود"

msgid "All available stations with their modules are displayed one by one with defined switching time"
msgstr "همهٔ ایستگاه‌های موجود و ماژول‌های آن‌ها، یکی پس از دیگری با فاصلهٔ زمانی تعیین‌شده نمایش داده می‌شوند"

msgid "Info is displayed from Station selected in Netatmo plugin"
msgstr "اطلاعات ایستگاه انتخاب‌شده در افزونهٔ Netatmo نمایش داده می‌شود"

msgid "Time in seconds"
msgstr "زمان بر حسب ثانیه"

msgid "Real tuner data are displayed"
msgstr "اطلاعات واقعی تیونر نمایش داده می‌شود"

msgid "Data are displayed from Transponder information"
msgstr "داده‌ها از اطلاعات ترانسپوندر گرفته می‌شوند"

msgid "Animations are disabled"
msgstr "انیمیشن‌ها غیرفعال هستند"

msgid "Selected animations are applyied to selected objects"
msgstr "انیمیشن‌های انتخاب‌شده روی عناصر انتخاب‌شده اعمال می‌شوند"

msgid "Do not display info about HDD/SSD state"
msgstr "اطلاعات وضعیت HDD/SSD را نمایش نده"

msgid "HDD/SSD temperature, size and free space is displayed in EMC and Movieplayer infobar"
msgstr "دما، ظرفیت و فضای خالی HDD/SSD در نوار اطلاعات EMC و Movieplayer نمایش داده می‌شود"

msgid "Last 10 searched channels are displayed only"
msgstr "فقط ۱۰ کانال آخرِ جست‌وجوشده نمایش داده می‌شوند"

msgid "Searched channels are displayed as long list and you can browse in the list"
msgstr "کانال‌های جست‌وجوشده در فهرستی بلند و قابل پیمایش نمایش داده می‌شوند"

msgid "Refresh time between frames of animated icon (default value is 50ms)"
msgstr "فاصلهٔ به‌روزرسانی بین فریم‌های نماد متحرک (پیش‌فرض: 50 ms)"

msgid "Apply to all screens where the listbox is used"
msgstr "روی همهٔ صفحه‌هایی که دارای فهرست هستند اعمال شود"

msgid "Nighttime icons are replaced by daytime icons"
msgstr "نمادهای شب با نمادهای روز جایگزین می‌شوند"

msgid "Nighttime icons are displayed"
msgstr "نمادهای شب نمایش داده می‌شوند"

msgid "Press button \"OK\" to activate selected function"
msgstr "برای فعال‌کردن عملکرد انتخاب‌شده دکمهٔ \"OK\" را فشار دهید"

msgid "Spinner will be used as default from image"
msgstr "به‌طور پیش‌فرض از انیمیشن انتظارِ ایمیج سیستم استفاده می‌شود"

msgid "Spinner will be used from Full HD Glass17. Original spinner is moved to dir spinner-ori"
msgstr "از انیمیشن انتظار Full HD Glass17 استفاده می‌شود؛ انیمیشن اصلی به پوشهٔ spinner-ori منتقل می‌شود"

msgid "EPG list will be displayed with selected font size"
msgstr "فهرست EPG با اندازهٔ قلم انتخاب‌شده نمایش داده می‌شود"

msgid "PIP types of channel selections are unavailable"
msgstr "حالت‌های انتخاب کانال PIP در دسترس نیستند"

msgid "PIP types of channel selections are available but it can generate GSOD in some images"
msgstr "حالت‌های انتخاب کانال PIP در دسترس‌اند، اما ممکن است در برخی ایمیج‌ها خطای GSOD ایجاد کنند"

msgid "Directory where is located the file: satellites.xml"
msgstr "پوشه‌ای که فایل satellites.xml در آن قرار دارد"

msgid "Directory where will be saved actual configuration of FHDG (file: hdg17.conf)"
msgstr "پوشهٔ ذخیرهٔ تنظیمات FHDG (فایل hdg17.conf)"

msgid "Display forecast for 5 days"
msgstr "نمایش پیش‌بینی هوا برای ۵ روز"

msgid "Display forecast for 10 days at first 5 days after timeout of switch time display next 5 days"
msgstr "نمایش پیش‌بینی ۱۰ روزه؛ ابتدا ۵ روز نخست و پس از زمان تعویض، ۵ روز بعدی"

msgid "Appears info about sunrise, sunset of planets, sun and moon"
msgstr "اطلاعات طلوع و غروب سیاره‌ها، خورشید و ماه نمایش داده می‌شود"

msgid "Sorry, help info is missing"
msgstr "متأسفانه اطلاعات راهنما موجود نیست"

msgid "Info is displayed with defined color"
msgstr "اطلاعات با رنگ تعیین‌شده نمایش داده می‌شود"

msgid "Info is displayed with autoselected color"
msgstr "اطلاعات با رنگی که خودکار انتخاب شده نمایش داده می‌شود"

msgid "Show extra screen only"
msgstr "فقط صفحهٔ اضافی را نمایش بده"

msgid "None special info is selected"
msgstr "هیچ اطلاعات ویژه‌ای انتخاب نشده است"

msgid "Show extra infobar only"
msgstr "فقط نوار اطلاعات اضافی را نمایش بده"

msgid "Show side bar and extra infobar only"
msgstr "فقط نوار کناری و نوار اطلاعات اضافی را نمایش بده"

msgid "1 - fastest, 10 - slowest"
msgstr "۱ – سریع‌ترین، ۱۰ – کندترین"

msgid "Infobar appears immediately and disapears immediately"
msgstr "نوار اطلاعات بلافاصله ظاهر و بلافاصله ناپدید می‌شود"

msgid "Infobar (dis)appears from full/defined transparency to defined(full) transparency"
msgstr "نوار اطلاعات هنگام ظاهرشدن یا محوشدن، شفافیت را بین مقدار کامل و مقدار تعیین‌شده تغییر می‌دهد"

msgid "Infobar appears immediately and disapears from defined to full transparency"
msgstr "نوار اطلاعات بلافاصله ظاهر می‌شود و با تغییر شفافیت از مقدار تعیین‌شده به شفافیت کامل ناپدید می‌شود"

msgid "Show extra infobar and press 2xOK show User info"
msgstr "نوار اطلاعات اضافی را نشان بده؛ برای دیدن اطلاعات کاربر، دو بار \"OK\" را فشار بده"

msgid "Apears user info press 2x\"OK\" and disappears with extra infobar"
msgstr "اطلاعات کاربر با دو بار فشار دادن \"OK\" ظاهر می‌شود و همراه نوار اطلاعات اضافی ناپدید می‌شود"

msgid "Apears user info press 2x\"OK\" and disappears press \"OK\" or \"exit\""
msgstr "اطلاعات کاربر با دو بار فشار دادن \"OK\" ظاهر می‌شود و با \"OK\" یا \"exit\" ناپدید می‌شود"

msgid "Show actual event(EPG) only"
msgstr "فقط برنامهٔ فعلی (EPG) را نمایش بده"

msgid "Press long \">\" switch between actual and next evet(EPG)"
msgstr "برای جابه‌جایی میان برنامهٔ فعلی و بعدی (EPG)، دکمهٔ \">\" را نگه دارید"

msgid "Display ECM PID info with extra infobar"
msgstr "اطلاعات ECM PID را در نوار اطلاعات اضافی نمایش بده"

msgid "Show events name in infobar as static text"
msgstr "نام برنامه‌ها را به‌صورت متن ثابت در نوار اطلاعات نمایش بده"

msgid "Show events name in infobar char by char with typewritter effect"
msgstr "نام برنامه‌ها را حرف‌به‌حرف با جلوهٔ ماشین‌تحریر در نوار اطلاعات نمایش بده"

msgid "Show OLED design from \"image\" definition"
msgstr "طرح OLED تعریف‌شده در ایمیج سیستم را نمایش بده"

msgid "Display \"Btr too high - stopped\" if realtime bitrate is higher as the set value"
msgstr "اگر نرخ بیت لحظه‌ای از مقدار تنظیم‌شده بیشتر شد، پیام \"Btr too high - stopped\" را نمایش بده"

msgid "Use only if in your image is keymapping set to \"standard Enigma2\""
msgstr "فقط زمانی استفاده کنید که نگاشت کلیدها در ایمیج شما روی \"standard Enigma2\" تنظیم شده باشد"

msgid "Use only if in your image is keymapping set to \"Neutrino keymap type\""
msgstr "فقط زمانی استفاده کنید که نگاشت کلیدها در ایمیج شما روی \"Neutrino keymap type\" تنظیم شده باشد"

msgid "Show messages in default language - english"
msgstr "نمایش پیام‌ها به زبان پیش‌فرض، یعنی انگلیسی"

msgid "Show localized messages autodetected from active OSD setting of language"
msgstr "نمایش پیام‌های ترجمه‌شده به زبانی که از تنظیمات فعال OSD به‌صورت خودکار تشخیص داده می‌شود"

msgid "Infobar disappears after a defined timeout in system settings"
msgstr "نوار اطلاعات پس از مدت تعیین‌شده در تنظیمات سیستم ناپدید می‌شود"

msgid "Infobar activated by switching between channels disappears after a defined timeout in system settings. Infobar activated press \"OK\" appears permanently but can be cancelled press \"exit\" or \"OK\""
msgstr "نوار اطلاعاتی که با تعویض کانال باز شده، پس از زمان تعیین‌شده محو می‌شود. نواری که با \"OK\" باز شود، تا فشار دادن \"exit\" یا \"OK\" باقی می‌ماند"

msgid "Infobar activated press \"OK\" appears permanently but disappears press \"exit\" or \"OK\""
msgstr "نوار اطلاعاتی که با \"OK\" باز شود، تا فشار دادن \"exit\" یا \"OK\" روی صفحه می‌ماند"

msgid "Check connection to the point in internet defined by IP adress"
msgstr "با اتصال به نشانی IP تعیین‌شده، اتصال اینترنت را بررسی کن"

msgid "Wake up HDD/SSD is managing by image only"
msgstr "بیدارکردن HDD/SSD فقط توسط ایمیج سیستم مدیریت می‌شود"

msgid "Wake up HDD/SSD if any function cannot read requested info if HDD/SSD is sleeping"
msgstr "اگر HDD/SSD در حالت خواب باشد و یک عملکرد نتواند اطلاعات لازم را بخواند، دیسک را بیدار کن"

msgid "auto - autodetection of tuners presented in box; value (1-19) - display selected numbers of tuners"
msgstr "auto – شناسایی خودکار تیونرهای گیرنده؛ عدد (1–19) – نمایش تعداد تعیین‌شدهٔ تیونرها"

msgid "Do not display flashing icon \"R\" in infobar"
msgstr "نماد چشمک‌زن \"R\" را در نوار اطلاعات نشان نده"

msgid "Display flashing icon \"R\" in infobar"
msgstr "نماد چشمک‌زن \"R\" را در نوار اطلاعات نشان بده"

msgid "Leave memory management untouched"
msgstr "مدیریت حافظه را بدون تغییر بگذار"

msgid "Detecting AC3/Dolby in all available audio tracks"
msgstr "تشخیص AC3/Dolby در همهٔ مسیرهای صوتی موجود"

msgid "Detecting AC3/Dolby, Dolby Digital 5.1/2.0, DTS, AAC, Mpeg in current audio track"
msgstr "تشخیص AC3/Dolby، Dolby Digital 5.1/2.0، DTS، AAC و MPEG در مسیر صوتی فعلی"

msgid "Automatic memory cleaning - refresh time: 3min"
msgstr "پاک‌سازی خودکار حافظه – فاصلهٔ به‌روزرسانی: ۳ دقیقه"

msgid "IP Address used for network status check - available connection to the Internet"
msgstr "نشانی IP مورد استفاده برای بررسی وضعیت اتصال اینترنت"

msgid "Used to encoding.conf origin from active image"
msgstr "از فایل encoding.conf موجود در ایمیج فعال استفاده کن"

msgid "Used to encoding-user.conf located in /usr/share/enigma2"
msgstr "از فایل encoding-user.conf واقع در /usr/share/enigma2 استفاده کن"

msgid "Channel selection works with standard functionality"
msgstr "انتخاب کانال به شیوهٔ استاندارد انجام می‌شود"

msgid "Press \"OK\" - activate selected channel and channel selection no appear then press \"OK\" - disappear channel selection or press \"exit\" revert on last playd channel before activating Channel selection"
msgstr "\"OK\" کانال انتخاب‌شده را فعال می‌کند و فهرست کانال‌ها نمایش داده نمی‌شود؛ با \"OK\" بعدی فهرست بسته می‌شود و با \"exit\" به کانالی که پیش از بازکردن انتخاب کانال پخش می‌شد برمی‌گردید"

msgid "Press \"OK\" to start selected item without animation"
msgstr "برای اجرای گزینهٔ انتخاب‌شده بدون انیمیشن، \"OK\" را فشار دهید"

msgid "Press \"OK\" to start animation before activating selected item"
msgstr "برای اجرای انیمیشن پیش از فعال‌شدن گزینهٔ انتخاب‌شده، \"OK\" را فشار دهید"

msgid "Show Weather for selected city in the setup"
msgstr "وضعیت هوای شهر انتخاب‌شده در تنظیمات را نمایش بده"

msgid "Press \">\" show Weather for next city"
msgstr "برای نمایش هوای شهر بعدی دکمهٔ \">\" را فشار دهید"

msgid "Special info screen (activated press \"help\") disappear press \"help\""
msgstr "صفحهٔ اطلاعات ویژه که با \"help\" باز شده، با \"help\" بسته می‌شود"

msgid "Special info screen (activated press \"help\") disappear automatically after 20s"
msgstr "صفحهٔ اطلاعات ویژه که با \"help\" باز شده، پس از ۲۰ ثانیه خودکار بسته می‌شود"

msgid "Refresh time for reading ecm.info file"
msgstr "فاصلهٔ به‌روزرسانی خواندن فایل ecm.info"

msgid "Disable autocheck of new version of the HDG"
msgstr "بررسی خودکار نسخهٔ جدید HDG را غیرفعال کن"

msgid "Enable autocheck of new version of the HDG"
msgstr "بررسی خودکار نسخهٔ جدید HDG را فعال کن"

msgid "Static text - no scrolling"
msgstr "متن ثابت – بدون پیمایش"

msgid "Roll up at end of text and stop wait selected seconds (text roll delay) then roll down back"
msgstr "متن را تا انتها به بالا ببر، به‌اندازهٔ زمان انتخاب‌شده مکث کن و سپس به پایین برگردان"

msgid "Roll up at end of text and stop"
msgstr "متن را تا انتها به بالا ببر و متوقف کن"

msgid "Text rolling starts with delay defined in skin.xml"
msgstr "پیمایش متن پس از تأخیر تعیین‌شده در skin.xml آغاز می‌شود"

msgid "Text rolling starts with selected delay (s)"
msgstr "پیمایش متن پس از تأخیر انتخاب‌شده (ثانیه) آغاز می‌شود"

msgid "Show channel name only"
msgstr "فقط نام کانال را نمایش بده"

msgid "Show number and channel name"
msgstr "شماره و نام کانال را نمایش بده"

msgid "Show satellite position and channel name"
msgstr "موقعیت ماهواره و نام کانال را نمایش بده"

msgid "Show number, satellite position and channel name"
msgstr "شماره، موقعیت ماهواره و نام کانال را نمایش بده"

msgid "None info about \"Provider\" in infobar"
msgstr "اطلاعات \"Provider\" را در نوار اطلاعات نمایش نده"

msgid "Show info about \"Provider\" in infobar"
msgstr "اطلاعات \"Provider\" را در نوار اطلاعات نمایش بده"

msgid "None info about \"Temperature and RPM\" in infobar"
msgstr "اطلاعات \"Temperature and RPM\" را در نوار اطلاعات نمایش نده"

msgid "Show info about \"Temperature and RPM\" in infobar"
msgstr "اطلاعات \"Temperature and RPM\" را در نوار اطلاعات نمایش بده"

msgid "None info about \"CPU usage and Memory usage\" in infobar"
msgstr "اطلاعات \"CPU usage and Memory usage\" را در نوار اطلاعات نمایش نده"

msgid "Show info about \"CPU usage and Memory usage\" in infobar"
msgstr "اطلاعات \"CPU usage and Memory usage\" را در نوار اطلاعات نمایش بده"

msgid "None info about \"Temperature HDD/SSD\" in infobar"
msgstr "اطلاعات \"Temperature HDD/SSD\" را در نوار اطلاعات نمایش نده"

msgid "Show info about \"Temperature HDD/SSD\" in infobar"
msgstr "اطلاعات \"Temperature HDD/SSD\" را در نوار اطلاعات نمایش بده"

msgid "Do not display selected special info \"extensions\" in main menu"
