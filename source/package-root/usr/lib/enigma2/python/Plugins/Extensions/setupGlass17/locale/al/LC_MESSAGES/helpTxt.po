msgid "Legacy FullHDGlass custom spinner is retired; the image spinner is preserved"
msgstr "Animacioni i vjetër i pritjes i FullHDGlass nuk përdoret më. Ruhet animacioni i imazhit të sistemit."

msgid "Legacy weather API key (unused; Open-Meteo needs no API key)"
msgstr "Çelësi i vjetër API për motin nuk përdoret më. Open-Meteo nuk kërkon çelës API."

msgid "Legacy weather provider setting is no longer used"
msgstr "Cilësimi i vjetër i ofruesit të motit nuk përdoret më"

msgid "Please install beautifulsoup4"
msgstr "Instaloni beautifulsoup4"

msgid "System spinner provided by the image is used"
msgstr "Përdoret animacioni i pritjes që përmban imazhi i sistemit"

msgid "Weather data is provided by Open-Meteo; no API key is required"
msgstr "Të dhënat e motit vijnë nga Open-Meteo. Nuk kërkohet çelës API."

msgid "N/A"
msgstr "Nuk disponohet"

msgid "free"
msgstr "i lirë"

msgid "TP info is not detected"
msgstr "Informacioni i transponderit nuk u zbulua"

msgid "Reference is not detected"
msgstr "Referenca nuk u zbulua"

msgid "No EPG data available"
msgstr "Nuk ka të dhëna EPG"

msgid "Please wait for the reading and processing of data"
msgstr "Ju lutemi prisni derisa të lexohen dhe përpunohen të dhënat"

msgid "Press button \"OK\" to select favorite directory."
msgstr "Shtypni \"OK\" për të zgjedhur dosjen e të preferuarave."

msgid "Autocolor - use definition from skin.xml or g17Screens.py; selected color - display with selected color"
msgstr "Ngjyra automatike – përdor përkufizimin nga skin.xml ose g17Screens.py; ngjyra e zgjedhur – shfaqet me ngjyrën e caktuar"

msgid "Channels from all satelitte positions and sk/cz terrestrial channels"
msgstr "Kanalet nga të gjitha pozicionet satelitore dhe kanalet tokësore SK/CZ"

msgid "No plugin Netatmo installed"
msgstr "Shtojca Netatmo nuk është instaluar"

msgid "Your API-key"
msgstr "Çelësi juaj API"

msgid "The layout is selected automatically calculating by picon size in the infobar"
msgstr "Paraqitja llogaritet automatikisht sipas madhësisë së picon-it në shiritin e informacionit"

msgid "Measurement of current network speed is disabled"
msgstr "Matja e shpejtësisë aktuale të rrjetit është çaktivizuar"

msgid "Measurement of current network speed is enabled and is displayed in kb/s"
msgstr "Matja e shpejtësisë aktuale të rrjetit është aktivizuar dhe shfaqet në kb/s"

msgid "Measurement of current network speed is enabled and is displayed in Mb/s"
msgstr "Matja e shpejtësisë aktuale të rrjetit është aktivizuar dhe shfaqet në Mb/s"

msgid "Poster is displayed if exists"
msgstr "Posteri shfaqet nëse ekziston"

msgid "Currently displayed Poster will be erased after press long \"OK\" and do not displayed back again"
msgstr "Posteri i shfaqur fshihet duke mbajtur shtypur \"OK\" dhe nuk do të shfaqet përsëri"

msgid "Poster search from \"Internet Movie Database (IMDb)\""
msgstr "Kërko poster në \"Internet Movie Database (IMDb)\""

msgid "Poster search from \"The Movie Database (TMDb)\""
msgstr "Kërko poster në \"The Movie Database (TMDb)\""

msgid "Poster search from \"Internet Movie Database (IMDb) if not found then search from \"The Movie Database (TMDb)\""
msgstr "Kërko poster fillimisht në \"Internet Movie Database (IMDb)\"; nëse nuk gjendet, kërko në \"The Movie Database (TMDb)\""

msgid "Poster search is started with selected delay"
msgstr "Kërkimi i posterit nis pas vonesës së zgjedhur"

msgid "Poster is displayed with the selected size"
msgstr "Posteri shfaqet në madhësinë e zgjedhur"

msgid "ECM info is displayed from all channels - current displayed, background recording, streaming etc."
msgstr "Informacioni ECM shfaqet për të gjitha kanalet, përfshirë kanalin aktual, regjistrimet në sfond dhe transmetimet përmes rrjetit"

msgid "ECM info is displayed from current channel"
msgstr "Informacioni ECM shfaqet vetëm për kanalin aktual"

msgid "Bitrate is calculated by using included bitrate binary"
msgstr "Shpejtësia e biteve llogaritet me programin bitrate të përfshirë"

msgid "Bitrate is calculated by using eBitrateCalculator from plugin BitrateViewer"
msgstr "Shpejtësia e biteve llogaritet me eBitrateCalculator nga shtojca BitrateViewer"

msgid "All available stations with their modules are displayed one by one with defined switching time"
msgstr "Të gjitha stacionet e disponueshme dhe modulet e tyre shfaqen një nga një, sipas intervalit të caktuar të ndërrimit"

msgid "Info is displayed from Station selected in Netatmo plugin"
msgstr "Shfaqen të dhënat e stacionit të zgjedhur në shtojcën Netatmo"

msgid "Time in seconds"
msgstr "Koha në sekonda"

msgid "Real tuner data are displayed"
msgstr "Shfaqen të dhënat reale të tunerit"

msgid "Data are displayed from Transponder information"
msgstr "Të dhënat merren nga informacioni i transponderit"

msgid "Animations are disabled"
msgstr "Animacionet janë çaktivizuar"

msgid "Selected animations are applyied to selected objects"
msgstr "Animacionet e zgjedhura zbatohen te objektet e zgjedhura"

msgid "Do not display info about HDD/SSD state"
msgstr "Mos shfaq informacion për gjendjen e HDD/SSD"

msgid "HDD/SSD temperature, size and free space is displayed in EMC and Movieplayer infobar"
msgstr "Temperatura, kapaciteti dhe hapësira e lirë e HDD/SSD shfaqen në shiritin e informacionit të EMC dhe Movieplayer"

msgid "Last 10 searched channels are displayed only"
msgstr "Shfaqen vetëm 10 kanalet e kërkuara së fundi"

msgid "Searched channels are displayed as long list and you can browse in the list"
msgstr "Kanalet e kërkuara shfaqen në një listë të gjatë që mund të shfletohet"

msgid "Refresh time between frames of animated icon (default value is 50ms)"
msgstr "Intervali i rifreskimit mes kuadrove të ikonës së animuar (parazgjedhja: 50 ms)"

msgid "Apply to all screens where the listbox is used"
msgstr "Zbatoje në të gjitha ekranet ku përdoret lista"

msgid "Nighttime icons are replaced by daytime icons"
msgstr "Ikonat e natës zëvendësohen me ikona të ditës"

msgid "Nighttime icons are displayed"
msgstr "Shfaqen ikonat e natës"

msgid "Press button \"OK\" to activate selected function"
msgstr "Shtypni \"OK\" për të aktivizuar funksionin e zgjedhur"

msgid "Spinner will be used as default from image"
msgstr "Si parazgjedhje përdoret animacioni i pritjes nga imazhi i sistemit"

msgid "Spinner will be used from Full HD Glass17. Original spinner is moved to dir spinner-ori"
msgstr "Përdoret animacioni i pritjes nga Full HD Glass17; animacioni origjinal zhvendoset në dosjen spinner-ori"

msgid "EPG list will be displayed with selected font size"
msgstr "Lista EPG shfaqet me madhësinë e zgjedhur të shkronjave"

msgid "PIP types of channel selections are unavailable"
msgstr "Llojet e zgjedhjes së kanaleve PIP nuk disponohen"

msgid "PIP types of channel selections are available but it can generate GSOD in some images"
msgstr "Llojet e zgjedhjes së kanaleve PIP disponohen, por mund të shkaktojnë gabim GSOD në disa imazhe"

msgid "Directory where is located the file: satellites.xml"
msgstr "Dosja ku ndodhet skedari satellites.xml"

msgid "Directory where will be saved actual configuration of FHDG (file: hdg17.conf)"
msgstr "Dosja ku do të ruhet konfigurimi FHDG (skedari hdg17.conf)"

msgid "Display forecast for 5 days"
msgstr "Shfaq parashikimin e motit për 5 ditë"

msgid "Display forecast for 10 days at first 5 days after timeout of switch time display next 5 days"
msgstr "Shfaq parashikimin për 10 ditë: fillimisht 5 ditët e para, pastaj 5 ditët e tjera pas intervalit të ndërrimit"

msgid "Appears info about sunrise, sunset of planets, sun and moon"
msgstr "Shfaqen orët e lindjes dhe perëndimit të planetëve, Diellit dhe Hënës"

msgid "Sorry, help info is missing"
msgstr "Na vjen keq, mungon informacioni i ndihmës"

msgid "Info is displayed with defined color"
msgstr "Informacioni shfaqet me ngjyrën e përcaktuar"

msgid "Info is displayed with autoselected color"
msgstr "Informacioni shfaqet me ngjyrën e zgjedhur automatikisht"

msgid "Show extra screen only"
msgstr "Shfaq vetëm ekranin shtesë"

msgid "None special info is selected"
msgstr "Nuk është zgjedhur informacion i veçantë"

msgid "Show extra infobar only"
msgstr "Shfaq vetëm shiritin shtesë të informacionit"

msgid "Show side bar and extra infobar only"
msgstr "Shfaq vetëm shiritin anësor dhe shiritin shtesë të informacionit"

msgid "1 - fastest, 10 - slowest"
msgstr "1 – më i shpejti, 10 – më i ngadalshmi"

msgid "Infobar appears immediately and disapears immediately"
msgstr "Shiriti i informacionit shfaqet dhe zhduket menjëherë"

msgid "Infobar (dis)appears from full/defined transparency to defined(full) transparency"
msgstr "Shiriti i informacionit shfaqet ose zhduket duke ndryshuar tejdukshmërinë nga e plotë/niveli i caktuar në nivelin e caktuar/të plotë"

msgid "Infobar appears immediately and disapears from defined to full transparency"
msgstr "Shiriti i informacionit shfaqet menjëherë dhe zhduket duke kaluar nga tejdukshmëria e caktuar në të plotë"

msgid "Show extra infobar and press 2xOK show User info"
msgstr "Shfaq shiritin shtesë të informacionit; shtyp dy herë \"OK\" për informacionin e përdoruesit"

msgid "Apears user info press 2x\"OK\" and disappears with extra infobar"
msgstr "Informacioni i përdoruesit shfaqet pas dy shtypjeve të \"OK\" dhe zhduket bashkë me shiritin shtesë"

msgid "Apears user info press 2x\"OK\" and disappears press \"OK\" or \"exit\""
msgstr "Informacioni i përdoruesit shfaqet pas dy shtypjeve të \"OK\" dhe zhduket me \"OK\" ose \"exit\""

msgid "Show actual event(EPG) only"
msgstr "Shfaq vetëm programin aktual (EPG)"

msgid "Press long \">\" switch between actual and next evet(EPG)"
msgstr "Mbaj shtypur \">\" për të kaluar mes programit aktual dhe atij pasues (EPG)"

msgid "Display ECM PID info with extra infobar"
msgstr "Shfaq informacionin ECM PID në shiritin shtesë të informacionit"

msgid "Show events name in infobar as static text"
msgstr "Shfaq emrat e programeve si tekst statik në shiritin e informacionit"

msgid "Show events name in infobar char by char with typewritter effect"
msgstr "Shfaq emrat e programeve shkronjë pas shkronje me efekt makine shkrimi"

msgid "Show OLED design from \"image\" definition"
msgstr "Shfaq dizajnin OLED të përcaktuar në imazhin e sistemit"

msgid "Display \"Btr too high - stopped\" if realtime bitrate is higher as the set value"
msgstr "Shfaq \"Btr too high - stopped\" nëse shpejtësia e biteve në kohë reale tejkalon vlerën e caktuar"

msgid "Use only if in your image is keymapping set to \"standard Enigma2\""
msgstr "Përdore vetëm nëse hartëzimi i tastave në imazhin tuaj është \"standard Enigma2\""

msgid "Use only if in your image is keymapping set to \"Neutrino keymap type\""
msgstr "Përdore vetëm nëse hartëzimi i tastave në imazhin tuaj është \"Neutrino keymap type\""

msgid "Show messages in default language - english"
msgstr "Shfaq mesazhet në gjuhën parazgjedhje – anglisht"

msgid "Show localized messages autodetected from active OSD setting of language"
msgstr "Shfaq mesazhet e përkthyera sipas gjuhës aktive të zbuluar automatikisht nga cilësimet OSD"

msgid "Infobar disappears after a defined timeout in system settings"
msgstr "Shiriti i informacionit zhduket pas kohës së përcaktuar në cilësimet e sistemit"

msgid "Infobar activated by switching between channels disappears after a defined timeout in system settings. Infobar activated press \"OK\" appears permanently but can be cancelled press \"exit\" or \"OK\""
msgstr "Shiriti i informacionit i hapur gjatë ndërrimit të kanalit zhduket pas kohës së caktuar. Shiriti i hapur me \"OK\" mbetet derisa të mbyllet me \"exit\" ose \"OK\""

msgid "Infobar activated press \"OK\" appears permanently but disappears press \"exit\" or \"OK\""
msgstr "Shiriti i informacionit i hapur me \"OK\" mbetet derisa të mbyllet me \"exit\" ose \"OK\""

msgid "Check connection to the point in internet defined by IP adress"
msgstr "Kontrollo lidhjen me internetin duke u lidhur me adresën IP të përcaktuar"

msgid "Wake up HDD/SSD is managing by image only"
msgstr "Zgjimi i HDD/SSD menaxhohet vetëm nga imazhi i sistemit"

msgid "Wake up HDD/SSD if any function cannot read requested info if HDD/SSD is sleeping"
msgstr "Zgjo HDD/SSD nëse është në gjumë dhe një funksion nuk mund të lexojë të dhënat e kërkuara"

msgid "auto - autodetection of tuners presented in box; value (1-19) - display selected numbers of tuners"
msgstr "auto – zbulim automatik i tunerëve në marrës; vlerë (1–19) – shfaq numrin e zgjedhur të tunerëve"

msgid "Do not display flashing icon \"R\" in infobar"
msgstr "Mos shfaq ikonën pulsuese \"R\" në shiritin e informacionit"

msgid "Display flashing icon \"R\" in infobar"
msgstr "Shfaq ikonën pulsuese \"R\" në shiritin e informacionit"

msgid "Leave memory management untouched"
msgstr "Lëre të pandryshuar menaxhimin e kujtesës"

msgid "Detecting AC3/Dolby in all available audio tracks"
msgstr "Zbulo AC3/Dolby në të gjitha pistat audio të disponueshme"

msgid "Detecting AC3/Dolby, Dolby Digital 5.1/2.0, DTS, AAC, Mpeg in current audio track"
msgstr "Zbulo AC3/Dolby, Dolby Digital 5.1/2.0, DTS, AAC dhe MPEG në pistën aktuale audio"

msgid "Automatic memory cleaning - refresh time: 3min"
msgstr "Pastrimi automatik i kujtesës – intervali i rifreskimit: 3 minuta"

msgid "IP Address used for network status check - available connection to the Internet"
msgstr "Adresa IP që përdoret për kontrollin e gjendjes së lidhjes me internetin"

msgid "Used to encoding.conf origin from active image"
msgstr "Përdor skedarin encoding.conf nga imazhi aktiv i sistemit"

msgid "Used to encoding-user.conf located in /usr/share/enigma2"
msgstr "Përdor skedarin encoding-user.conf në /usr/share/enigma2"

msgid "Channel selection works with standard functionality"
msgstr "Zgjedhja e kanaleve funksionon në mënyrën standarde"

msgid "Press \"OK\" - activate selected channel and channel selection no appear then press \"OK\" - disappear channel selection or press \"exit\" revert on last playd channel before activating Channel selection"
msgstr "\"OK\" aktivizon kanalin e zgjedhur pa shfaqur listën; një shtypje tjetër e \"OK\" mbyll listën, ndërsa \"exit\" kthen kanalin që luhej para hapjes së zgjedhjes së kanaleve"

msgid "Press \"OK\" to start selected item without animation"
msgstr "Shtyp \"OK\" për të nisur elementin e zgjedhur pa animacion"

msgid "Press \"OK\" to start animation before activating selected item"
msgstr "Shtyp \"OK\" për të nisur animacionin para aktivizimit të elementit të zgjedhur"

msgid "Show Weather for selected city in the setup"
msgstr "Shfaq motin për qytetin e zgjedhur te cilësimet"

msgid "Press \">\" show Weather for next city"
msgstr "Shtyp \">\" për të shfaqur motin e qytetit pasues"

msgid "Special info screen (activated press \"help\") disappear press \"help\""
msgstr "Ekrani i informacionit të veçantë, i hapur me \"help\", mbyllet me \"help\""

msgid "Special info screen (activated press \"help\") disappear automatically after 20s"
msgstr "Ekrani i informacionit të veçantë, i hapur me \"help\", mbyllet automatikisht pas 20 sekondash"

msgid "Refresh time for reading ecm.info file"
msgstr "Intervali i rifreskimit për leximin e skedarit ecm.info"

msgid "Disable autocheck of new version of the HDG"
msgstr "Çaktivizo kontrollin automatik për versionet e reja të HDG"

msgid "Enable autocheck of new version of the HDG"
msgstr "Aktivizo kontrollin automatik për versionet e reja të HDG"

msgid "Static text - no scrolling"
msgstr "Tekst statik – pa lëvizje"

msgid "Roll up at end of text and stop wait selected seconds (text roll delay) then roll down back"
msgstr "Lëvize tekstin lart deri në fund, prit sekondat e zgjedhura dhe pastaj ktheje poshtë"

msgid "Roll up at end of text and stop"
msgstr "Lëvize tekstin lart deri në fund dhe ndalo"

msgid "Text rolling starts with delay defined in skin.xml"
msgstr "Lëvizja e tekstit nis pas vonesës së përcaktuar në skin.xml"

msgid "Text rolling starts with selected delay (s)"
msgstr "Lëvizja e tekstit nis pas vonesës së zgjedhur (s)"

msgid "Show channel name only"
msgstr "Shfaq vetëm emrin e kanalit"

msgid "Show number and channel name"
msgstr "Shfaq numrin dhe emrin e kanalit"

msgid "Show satellite position and channel name"
msgstr "Shfaq pozicionin satelitor dhe emrin e kanalit"

msgid "Show number, satellite position and channel name"
msgstr "Shfaq numrin, pozicionin satelitor dhe emrin e kanalit"

msgid "None info about \"Provider\" in infobar"
msgstr "Mos shfaq informacionin \"Provider\" në shiritin e informacionit"

msgid "Show info about \"Provider\" in infobar"
msgstr "Shfaq informacionin \"Provider\" në shiritin e informacionit"

msgid "None info about \"Temperature and RPM\" in infobar"
msgstr "Mos shfaq informacionin \"Temperature and RPM\" në shiritin e informacionit"

msgid "Show info about \"Temperature and RPM\" in infobar"
msgstr "Shfaq informacionin \"Temperature and RPM\" në shiritin e informacionit"

msgid "None info about \"CPU usage and Memory usage\" in infobar"
msgstr "Mos shfaq informacionin \"CPU usage and Memory usage\" në shiritin e informacionit"

msgid "Show info about \"CPU usage and Memory usage\" in infobar"
msgstr "Shfaq informacionin \"CPU usage and Memory usage\" në shiritin e informacionit"

msgid "None info about \"Temperature HDD/SSD\" in infobar"
msgstr "Mos shfaq informacionin \"Temperature HDD/SSD\" në shiritin e informacionit"

msgid "Show info about \"Temperature HDD/SSD\" in infobar"
msgstr "Shfaq informacionin \"Temperature HDD/SSD\" në shiritin e informacionit"

msgid "Do not display selected special info \"extensions\" in main menu"
msgstr "Mos shfaq informacionin e veçantë \"extensions\" të zgjedhur në menynë kryesore"

msgid "Display selected special info \"extensions\" in main menu"
msgstr "Shfaq informacionin e veçantë \"extensions\" të zgjedhur në menynë kryesore"

msgid "Temperature will be displayed with units defined in my_city_Code.txt or city_Code.txt"
msgstr "Shfaq temperaturën në njësitë e përcaktuara te my_city_Code.txt ose city_Code.txt"

msgid "Temperature will be displayed with units defined in eWea_city_Code.txt"
msgstr "Shfaq temperaturën në njësitë e përcaktuara te eWea_city_Code.txt"

msgid "Temperature will be displayed in Celsius"
msgstr "Shfaq temperaturën në gradë Celsius"

msgid "Temperature will be displayed in Fahrenheit"
msgstr "Shfaq temperaturën në gradë Fahrenheit"

msgid "Reconnect time for reading weather data from website in minutes"
msgstr "Intervali në minuta për rimarrjen e të dhënave të motit nga faqja e internetit"

msgid "Reading weather data from OpenWeatherMap but you have to enter your API-key from registration on the website openweathermap.org (Registration and base API-key is free) and can be readed from /etc/openweathermap.api"
msgstr "Merr të dhënat e motit nga OpenWeatherMap: regjistrohu te openweathermap.org dhe fut çelësin API (regjistrimi dhe çelësi bazë janë falas). Çelësi mund të lexohet edhe nga /etc/openweathermap.api"

msgid "Reading weather data from MSN website"
msgstr "Merr të dhënat e motit nga faqja MSN"

msgid "\"Find a city\" is disabled"
msgstr "Funksioni \"Find a city\" është çaktivizuar"

msgid "\"Find a city\" is disabled in extensions list"
msgstr "Funksioni \"Find a city\" është çaktivizuar në listën e shtojcave"

msgid "\"Find a city\" is disabled in main menu"
msgstr "Funksioni \"Find a city\" është çaktivizuar në menynë kryesore"

msgid "Do not try get data from provider if an error is detected"
msgstr "Nëse zbulohet gabim, mos provo të marrësh sërish të dhëna nga ofruesi"

msgid "Autoreconnect - try get data from provider if an error is detected - try with cycle in selected time while data are not ok"
msgstr "Rilidhje automatike: në rast gabimi provo të marrësh sërish të dhëna nga ofruesi në intervalin e zgjedhur, derisa të dhënat të jenë të sakta"

msgid "Display forecast for today and next 3 days"
msgstr "Shfaq parashikimin për sot dhe 3 ditët e ardhshme"

msgid "Display forecast for yesterday, today and next 3 days"
msgstr "Shfaq parashikimin për dje, sot dhe 3 ditët e ardhshme"

msgid "High temperature appear in Autocolor"
msgstr "Temperatura e lartë shfaqet me ngjyrën automatike"

msgid "High temperature appear in selected color"
msgstr "Temperatura e lartë shfaqet me ngjyrën e zgjedhur"

msgid "Low temperature appear in Autocolor"
msgstr "Temperatura e ulët shfaqet me ngjyrën automatike"

msgid "Low temperature appear in selected color"
msgstr "Temperatura e ulët shfaqet me ngjyrën e zgjedhur"

msgid "Cold/warm temperature appears in selected color (Cold/Warm color)"
msgstr "Temperatura e ftohtë/e ngrohtë shfaqet me ngjyrën e zgjedhur (ngjyra e ftohtë/e ngrohtë)"

msgid "Cold temperature is higher as settings of \"Cold temperature\" or/and Warm temperature is lower as \"Warm temperature\""
msgstr "Temperatura e ftohtë është mbi cilësimin \"Cold temperature\" dhe/ose temperatura e ngrohtë është nën cilësimin \"Warm temperature\""

msgid "Warm temperature limit range: 15-40"
msgstr "Intervali i kufirit për temperaturë të ngrohtë: 15–40"

msgid "Cold temperature limit range: 1-14"
msgstr "Intervali i kufirit për temperaturë të ftohtë: 1–14"

msgid "Warm temperature limit range: 58-104"
msgstr "Intervali i kufirit për temperaturë të ngrohtë: 58–104"

msgid "Cold temperature limit range: 33-57"
msgstr "Intervali i kufirit për temperaturë të ftohtë: 33–57"

msgid "HDD/SSD detected by kernel as device"
msgstr "HDD/SSD i zbuluar si pajisje nga kerneli"

msgid "Path to all required directories like picon, piconProv and more."
msgstr "Rruga drejt të gjitha dosjeve të nevojshme, si picon, piconProv etj."

msgid "User defined path to all required directories like picon, piconProv and more."
msgstr "Rruga e përcaktuar nga përdoruesi drejt të gjitha dosjeve të nevojshme, si picon, piconProv etj."

msgid "Channel numbers are calculated at enigma start so any change in channels order have no effect to channel numbers"
msgstr "Numrat e kanaleve llogariten në nisjen e Enigma, prandaj ndryshimi i rendit të kanaleve nuk i ndryshon numrat"

msgid "Channel number is calculated after switching between channels always so every change in channel order is applied on calculation of channel number"
msgstr "Numri i kanalit rillogaritet pas çdo ndërrimi; çdo ndryshim i rendit të kanaleve pasqyrohet në numërim"

msgid "Date format will be used from definition in skin part"
msgstr "Formati i datës merret nga përkufizimi në pjesën e skin-it"

msgid "Date format will be used as follow"
msgstr "Formati i datës do të jetë si më poshtë"

msgid "Channel logos with white background"
msgstr "Logot e kanaleve me sfond të bardhë"

msgid "Channel logos with black background"
msgstr "Logot e kanaleve me sfond të zi"

msgid "Channel logos for OLED display"
msgstr "Logot e kanaleve për ekran OLED"

msgid "Provider logos with white background"
