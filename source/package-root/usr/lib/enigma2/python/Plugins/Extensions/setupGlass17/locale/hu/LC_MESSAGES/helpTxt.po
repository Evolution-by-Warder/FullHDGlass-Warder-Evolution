msgid "Legacy FullHDGlass custom spinner is retired; the image spinner is preserved"
msgstr "A FullHDGlass korábbi egyéni várakozási animációja megszűnt. A rendszerkép animációja megmarad."

msgid "Legacy weather API key (unused; Open-Meteo needs no API key)"
msgstr "A régi időjárási API-kulcs már nincs használatban. Az Open-Meteo nem igényel API-kulcsot."

msgid "Legacy weather provider setting is no longer used"
msgstr "A korábbi időjárási szolgáltató beállítása már nincs használatban"

msgid "Please install beautifulsoup4"
msgstr "Telepítse a beautifulsoup4 csomagot"

msgid "System spinner provided by the image is used"
msgstr "A rendszerképhez tartozó várakozási animáció van használatban"

msgid "Weather data is provided by Open-Meteo; no API key is required"
msgstr "Az időjárási adatokat az Open-Meteo szolgáltatja. API-kulcsra nincs szükség."

msgid "N/A"
msgstr "Nem érhető el"

msgid "free"
msgstr "szabad"

msgid "TP info is not detected"
msgstr "Nem sikerült felismerni a transzponder adatait"

msgid "Reference is not detected"
msgstr "Nem sikerült felismerni a hivatkozást"

msgid "No EPG data available"
msgstr "Nem állnak rendelkezésre EPG-adatok"

msgid "Please wait for the reading and processing of data"
msgstr "Várjon, amíg az adatok beolvasása és feldolgozása befejeződik"

msgid "Press button \"OK\" to select favorite directory."
msgstr "A kedvenc mappa kiválasztásához nyomja meg az \"OK\" gombot."

msgid "Autocolor - use definition from skin.xml or g17Screens.py; selected color - display with selected color"
msgstr "Automatikus szín: a skin.xml vagy a g17Screens.py meghatározását használja; választott szín: a megadott színnel jelenít meg"

msgid "Channels from all satelitte positions and sk/cz terrestrial channels"
msgstr "Csatornák az összes műholdpozícióról, valamint az SK/CZ földfelszíni csatornák"

msgid "No plugin Netatmo installed"
msgstr "A Netatmo bővítmény nincs telepítve"

msgid "Your API-key"
msgstr "Az Ön API-kulcsa"

msgid "The layout is selected automatically calculating by picon size in the infobar"
msgstr "Az elrendezés automatikusan igazodik az információs sávban megjelenő picon méretéhez"

msgid "Measurement of current network speed is disabled"
msgstr "Az aktuális hálózati sebesség mérése ki van kapcsolva"

msgid "Measurement of current network speed is enabled and is displayed in kb/s"
msgstr "Az aktuális hálózati sebesség mérése be van kapcsolva, az érték kb/s egységben látható"

msgid "Measurement of current network speed is enabled and is displayed in Mb/s"
msgstr "Az aktuális hálózati sebesség mérése be van kapcsolva, az érték Mb/s egységben látható"

msgid "Poster is displayed if exists"
msgstr "A poszter megjelenik, ha rendelkezésre áll"

msgid "Currently displayed Poster will be erased after press long \"OK\" and do not displayed back again"
msgstr "A megjelenített poszter az \"OK\" gomb hosszú megnyomásával törlődik, és többé nem jelenik meg"

msgid "Poster search from \"Internet Movie Database (IMDb)\""
msgstr "Poszter keresése az \"Internet Movie Database (IMDb)\" adatbázisban"

msgid "Poster search from \"The Movie Database (TMDb)\""
msgstr "Poszter keresése a \"The Movie Database (TMDb)\" adatbázisban"

msgid "Poster search from \"Internet Movie Database (IMDb) if not found then search from \"The Movie Database (TMDb)\""
msgstr "Poszter keresése először az \"Internet Movie Database (IMDb)\" adatbázisban; ha nincs találat, akkor a \"The Movie Database (TMDb)\" adatbázisban"

msgid "Poster search is started with selected delay"
msgstr "A poszter keresése a kiválasztott késleltetés után indul"

msgid "Poster is displayed with the selected size"
msgstr "A poszter a kiválasztott méretben jelenik meg"

msgid "ECM info is displayed from all channels - current displayed, background recording, streaming etc."
msgstr "Az ECM-adatok az összes csatornáról megjelennek, beleértve a nézett, háttérben rögzített és streamelt csatornákat is"

msgid "ECM info is displayed from current channel"
msgstr "Az ECM-adatok csak az aktuális csatornáról jelennek meg"

msgid "Bitrate is calculated by using included bitrate binary"
msgstr "A bitsebességet a mellékelt bitrate futtatható állomány számítja ki"

msgid "Bitrate is calculated by using eBitrateCalculator from plugin BitrateViewer"
msgstr "A bitsebességet a BitrateViewer bővítmény eBitrateCalculator modulja számítja ki"

msgid "All available stations with their modules are displayed one by one with defined switching time"
msgstr "Az összes elérhető állomás és moduljaik egymás után, a megadott váltási idővel jelennek meg"

msgid "Info is displayed from Station selected in Netatmo plugin"
msgstr "A Netatmo bővítményben kiválasztott állomás adatai jelennek meg"

msgid "Time in seconds"
msgstr "Idő másodpercben"

msgid "Real tuner data are displayed"
msgstr "A tuner tényleges adatai jelennek meg"

msgid "Data are displayed from Transponder information"
msgstr "Az adatok a transzponder információiból származnak"

msgid "Animations are disabled"
msgstr "Az animációk ki vannak kapcsolva"

msgid "Selected animations are applyied to selected objects"
msgstr "A kiválasztott animációk a kijelölt elemekre vonatkoznak"

msgid "Do not display info about HDD/SSD state"
msgstr "Ne jelenjenek meg a HDD/SSD állapotadatai"

msgid "HDD/SSD temperature, size and free space is displayed in EMC and Movieplayer infobar"
msgstr "A HDD/SSD hőmérséklete, kapacitása és szabad területe az EMC és a Movieplayer információs sávjában jelenik meg"

msgid "Last 10 searched channels are displayed only"
msgstr "Csak az utoljára keresett 10 csatorna jelenik meg"

msgid "Searched channels are displayed as long list and you can browse in the list"
msgstr "A keresett csatornák hosszú, böngészhető listában jelennek meg"

msgid "Refresh time between frames of animated icon (default value is 50ms)"
msgstr "Az animált ikon képkockái közötti frissítési idő (alapérték: 50 ms)"

msgid "Apply to all screens where the listbox is used"
msgstr "Alkalmazás minden olyan képernyőre, ahol listamező található"

msgid "Nighttime icons are replaced by daytime icons"
msgstr "Az éjszakai ikonokat nappali ikonok váltják fel"

msgid "Nighttime icons are displayed"
msgstr "Az éjszakai ikonok jelennek meg"

msgid "Press button \"OK\" to activate selected function"
msgstr "A kiválasztott funkció aktiválásához nyomja meg az \"OK\" gombot"

msgid "Spinner will be used as default from image"
msgstr "Alapértelmezés szerint a rendszerkép várakozási animációja használatos"

msgid "Spinner will be used from Full HD Glass17. Original spinner is moved to dir spinner-ori"
msgstr "A Full HD Glass17 várakozási animációja használatos; az eredeti animáció a spinner-ori mappába kerül"

msgid "EPG list will be displayed with selected font size"
msgstr "Az EPG-lista a kiválasztott betűmérettel jelenik meg"

msgid "PIP types of channel selections are unavailable"
msgstr "A PIP csatornaválasztási módok nem érhetők el"

msgid "PIP types of channel selections are available but it can generate GSOD in some images"
msgstr "A PIP csatornaválasztási módok elérhetők, de bizonyos rendszerképeken GSOD hibát okozhatnak"

msgid "Directory where is located the file: satellites.xml"
msgstr "A satellites.xml fájlt tartalmazó mappa"

msgid "Directory where will be saved actual configuration of FHDG (file: hdg17.conf)"
msgstr "Az FHDG beállításainak mentési mappája (hdg17.conf fájl)"

msgid "Display forecast for 5 days"
msgstr "5 napos időjárás-előrejelzés megjelenítése"

msgid "Display forecast for 10 days at first 5 days after timeout of switch time display next 5 days"
msgstr "10 napos előrejelzés: először az első 5 nap látható, majd a váltási idő után a következő 5 nap"

msgid "Appears info about sunrise, sunset of planets, sun and moon"
msgstr "A bolygók, a Nap és a Hold kelési és nyugvási idejének megjelenítése"

msgid "Sorry, help info is missing"
msgstr "Sajnáljuk, nincs súgóinformáció"

msgid "Info is displayed with defined color"
msgstr "Az információ a megadott színnel jelenik meg"

msgid "Info is displayed with autoselected color"
msgstr "Az információ automatikusan kiválasztott színnel jelenik meg"

msgid "Show extra screen only"
msgstr "Csak a kiegészítő képernyő megjelenítése"

msgid "None special info is selected"
msgstr "Nincs kiválasztva különleges információ"

msgid "Show extra infobar only"
msgstr "Csak a kiegészítő információs sáv megjelenítése"

msgid "Show side bar and extra infobar only"
msgstr "Csak az oldalsáv és a kiegészítő információs sáv megjelenítése"

msgid "1 - fastest, 10 - slowest"
msgstr "1 – leggyorsabb, 10 – leglassabb"

msgid "Infobar appears immediately and disapears immediately"
msgstr "Az információs sáv azonnal megjelenik és eltűnik"

msgid "Infobar (dis)appears from full/defined transparency to defined(full) transparency"
msgstr "Az információs sáv megjelenése és eltűnése során a teljes és a beállított átlátszóság között vált"

msgid "Infobar appears immediately and disapears from defined to full transparency"
msgstr "Az információs sáv azonnal megjelenik, majd a beállított átlátszóságról teljes átlátszóságra váltva eltűnik"

msgid "Show extra infobar and press 2xOK show User info"
msgstr "Kiegészítő információs sáv megjelenítése; a felhasználói adatokhoz nyomja meg kétszer az \"OK\" gombot"

msgid "Apears user info press 2x\"OK\" and disappears with extra infobar"
msgstr "A felhasználói információ kétszeri \"OK\" megnyomására megjelenik, majd a kiegészítő információs sávval együtt eltűnik"

msgid "Apears user info press 2x\"OK\" and disappears press \"OK\" or \"exit\""
msgstr "A felhasználói információ kétszeri \"OK\" megnyomására megjelenik, majd \"OK\" vagy \"exit\" megnyomására eltűnik"

msgid "Show actual event(EPG) only"
msgstr "Csak az aktuális műsor (EPG) megjelenítése"

msgid "Press long \">\" switch between actual and next evet(EPG)"
msgstr "Az aktuális és következő műsor (EPG) közti váltáshoz tartsa lenyomva a \">\" gombot"

msgid "Display ECM PID info with extra infobar"
msgstr "ECM PID-adatok megjelenítése a kiegészítő információs sávban"

msgid "Show events name in infobar as static text"
msgstr "Műsorcímek megjelenítése állandó szövegként az információs sávban"

msgid "Show events name in infobar char by char with typewritter effect"
msgstr "Műsorcímek megjelenítése betűnként, írógépeffektussal az információs sávban"

msgid "Show OLED design from \"image\" definition"
msgstr "A rendszerképben meghatározott OLED-kialakítás megjelenítése"

msgid "Display \"Btr too high - stopped\" if realtime bitrate is higher as the set value"
msgstr "A \"Btr too high - stopped\" üzenet megjelenítése, ha a valós idejű bitsebesség meghaladja a beállított értéket"

msgid "Use only if in your image is keymapping set to \"standard Enigma2\""
msgstr "Csak akkor használja, ha a rendszerkép billentyűkiosztása \"standard Enigma2\""

msgid "Use only if in your image is keymapping set to \"Neutrino keymap type\""
msgstr "Csak akkor használja, ha a rendszerkép billentyűkiosztása \"Neutrino keymap type\""

msgid "Show messages in default language - english"
msgstr "Üzenetek megjelenítése az alapértelmezett nyelven – angolul"

msgid "Show localized messages autodetected from active OSD setting of language"
msgstr "Üzenetek megjelenítése az aktív OSD nyelvi beállításból automatikusan felismert nyelven"

msgid "Infobar disappears after a defined timeout in system settings"
msgstr "Az információs sáv a rendszerbeállításokban megadott idő után eltűnik"

msgid "Infobar activated by switching between channels disappears after a defined timeout in system settings. Infobar activated press \"OK\" appears permanently but can be cancelled press \"exit\" or \"OK\""
msgstr "A csatornaváltáskor megjelenő információs sáv a beállított idő után eltűnik. Az \"OK\" gombbal megnyitott sáv addig látható, amíg az \"exit\" vagy az \"OK\" gombbal be nem zárja"

msgid "Infobar activated press \"OK\" appears permanently but disappears press \"exit\" or \"OK\""
msgstr "Az \"OK\" gombbal megnyitott információs sáv addig látható, amíg az \"exit\" vagy az \"OK\" gombbal be nem zárja"

msgid "Check connection to the point in internet defined by IP adress"
msgstr "Az internetkapcsolat ellenőrzése a megadott IP-címen keresztül"

msgid "Wake up HDD/SSD is managing by image only"
msgstr "A HDD/SSD felébresztését kizárólag a rendszerkép kezeli"

msgid "Wake up HDD/SSD if any function cannot read requested info if HDD/SSD is sleeping"
msgstr "A HDD/SSD felébresztése, ha alvó állapotban van, és egy funkció nem tudja kiolvasni a szükséges adatokat"

msgid "auto - autodetection of tuners presented in box; value (1-19) - display selected numbers of tuners"
msgstr "auto – a vevő tunerjeinek automatikus felismerése; érték (1–19) – a megadott számú tuner megjelenítése"

msgid "Do not display flashing icon \"R\" in infobar"
msgstr "Ne jelenjen meg a villogó \"R\" ikon az információs sávban"

msgid "Display flashing icon \"R\" in infobar"
msgstr "A villogó \"R\" ikon megjelenítése az információs sávban"

msgid "Leave memory management untouched"
msgstr "A memóriakezelés változatlanul hagyása"

msgid "Detecting AC3/Dolby in all available audio tracks"
msgstr "AC3/Dolby felismerése minden elérhető hangsávban"

msgid "Detecting AC3/Dolby, Dolby Digital 5.1/2.0, DTS, AAC, Mpeg in current audio track"
msgstr "AC3/Dolby, Dolby Digital 5.1/2.0, DTS, AAC és MPEG felismerése az aktuális hangsávban"

msgid "Automatic memory cleaning - refresh time: 3min"
msgstr "Automatikus memóriatisztítás – frissítési időköz: 3 perc"

msgid "IP Address used for network status check - available connection to the Internet"
msgstr "Az internetkapcsolat ellenőrzéséhez használt IP-cím"

msgid "Used to encoding.conf origin from active image"
msgstr "Az aktív rendszerkép encoding.conf fájljának használata"

msgid "Used to encoding-user.conf located in /usr/share/enigma2"
msgstr "A /usr/share/enigma2 mappában lévő encoding-user.conf fájl használata"

msgid "Channel selection works with standard functionality"
msgstr "A csatornaválasztás a szokásos módon működik"

msgid "Press \"OK\" - activate selected channel and channel selection no appear then press \"OK\" - disappear channel selection or press \"exit\" revert on last playd channel before activating Channel selection"
msgstr "Az \"OK\" aktiválja a kijelölt csatornát, a csatornalista nem jelenik meg; újabb \"OK\" bezárja a listát, az \"exit\" pedig visszatér a csatornaválasztás előtt nézett csatornára"

msgid "Press \"OK\" to start selected item without animation"
msgstr "A kiválasztott elem animáció nélküli indításához nyomja meg az \"OK\" gombot"

msgid "Press \"OK\" to start animation before activating selected item"
msgstr "A kiválasztott elem aktiválása előtt az animáció indításához nyomja meg az \"OK\" gombot"

msgid "Show Weather for selected city in the setup"
msgstr "A beállításokban kiválasztott város időjárásának megjelenítése"

msgid "Press \">\" show Weather for next city"
msgstr "A következő város időjárásának megjelenítéséhez nyomja meg a \">\" gombot"

msgid "Special info screen (activated press \"help\") disappear press \"help\""
msgstr "A \"help\" gombbal megnyitott különleges információs képernyő a \"help\" gombbal zárható be"

msgid "Special info screen (activated press \"help\") disappear automatically after 20s"
msgstr "A \"help\" gombbal megnyitott különleges információs képernyő 20 másodperc után automatikusan bezárul"

msgid "Refresh time for reading ecm.info file"
msgstr "Az ecm.info fájl kiolvasásának frissítési időköze"

msgid "Disable autocheck of new version of the HDG"
msgstr "A HDG új verzióinak automatikus ellenőrzése kikapcsolva"

msgid "Enable autocheck of new version of the HDG"
msgstr "A HDG új verzióinak automatikus ellenőrzése bekapcsolva"

msgid "Static text - no scrolling"
msgstr "Álló szöveg – nincs görgetés"

msgid "Roll up at end of text and stop wait selected seconds (text roll delay) then roll down back"
msgstr "Görgetés felfelé a szöveg végéig, várakozás a kiválasztott ideig, majd visszagörgetés lefelé"

msgid "Roll up at end of text and stop"
msgstr "Görgetés felfelé a szöveg végéig, majd megállás"

msgid "Text rolling starts with delay defined in skin.xml"
msgstr "A szöveg görgetése a skin.xml fájlban meghatározott késleltetéssel indul"

msgid "Text rolling starts with selected delay (s)"
msgstr "A szöveg görgetése a kiválasztott késleltetés (s) után indul"

msgid "Show channel name only"
msgstr "Csak a csatornanév megjelenítése"

msgid "Show number and channel name"
msgstr "A csatornaszám és a csatornanév megjelenítése"

msgid "Show satellite position and channel name"
msgstr "A műholdpozíció és a csatornanév megjelenítése"

msgid "Show number, satellite position and channel name"
msgstr "A csatornaszám, a műholdpozíció és a csatornanév megjelenítése"

msgid "None info about \"Provider\" in infobar"
msgstr "Ne jelenjen meg a \"Provider\" információs sávban"

msgid "Show info about \"Provider\" in infobar"
msgstr "A \"Provider\" megjelenítése az információs sávban"

msgid "None info about \"Temperature and RPM\" in infobar"
msgstr "Ne jelenjen meg a \"Temperature and RPM\" az információs sávban"

msgid "Show info about \"Temperature and RPM\" in infobar"
msgstr "A \"Temperature and RPM\" megjelenítése az információs sávban"

msgid "None info about \"CPU usage and Memory usage\" in infobar"
msgstr "Ne jelenjen meg a \"CPU usage and Memory usage\" az információs sávban"

msgid "Show info about \"CPU usage and Memory usage\" in infobar"
msgstr "A \"CPU usage and Memory usage\" megjelenítése az információs sávban"

msgid "None info about \"Temperature HDD/SSD\" in infobar"
msgstr "Ne jelenjen meg a \"Temperature HDD/SSD\" az információs sávban"

msgid "Show info about \"Temperature HDD/SSD\" in infobar"
msgstr "A \"Temperature HDD/SSD\" megjelenítése az információs sávban"

msgid "Do not display selected special info \"extensions\" in main menu"
msgstr "A kiválasztott különleges \"extensions\" információ elrejtése a főmenüben"

msgid "Display selected special info \"extensions\" in main menu"
msgstr "A kiválasztott különleges \"extensions\" információ megjelenítése a főmenüben"

msgid "Temperature will be displayed with units defined in my_city_Code.txt or city_Code.txt"
msgstr "A hőmérséklet megjelenítése a my_city_Code.txt vagy city_Code.txt fájlban meghatározott egységekben"

msgid "Temperature will be displayed with units defined in eWea_city_Code.txt"
msgstr "A hőmérséklet megjelenítése az eWea_city_Code.txt fájlban meghatározott egységekben"

msgid "Temperature will be displayed in Celsius"
msgstr "A hőmérséklet megjelenítése Celsius-fokban"

msgid "Temperature will be displayed in Fahrenheit"
msgstr "A hőmérséklet megjelenítése Fahrenheit-fokban"

msgid "Reconnect time for reading weather data from website in minutes"
msgstr "Az időjárási adatok weboldalról történő újbóli lekérésének időköze percekben"

msgid "Reading weather data from OpenWeatherMap but you have to enter your API-key from registration on the website openweathermap.org (Registration and base API-key is free) and can be readed from /etc/openweathermap.api"
msgstr "Időjárási adatok lekérése az OpenWeatherMap szolgáltatásból: regisztráljon az openweathermap.org oldalon, és adja meg az API-kulcsát (a regisztráció és az alap API-kulcs ingyenes). A kulcs a /etc/openweathermap.api fájlból is beolvasható"

msgid "Reading weather data from MSN website"
msgstr "Időjárási adatok lekérése az MSN weboldaláról"

msgid "\"Find a city\" is disabled"
msgstr "A \"Find a city\" funkció ki van kapcsolva"

msgid "\"Find a city\" is disabled in extensions list"
msgstr "A \"Find a city\" funkció ki van kapcsolva a bővítmények listájában"

msgid "\"Find a city\" is disabled in main menu"
msgstr "A \"Find a city\" funkció ki van kapcsolva a főmenüben"

msgid "Do not try get data from provider if an error is detected"
msgstr "Hiba észlelésekor ne próbáljon ismét adatokat lekérni a szolgáltatótól"

msgid "Autoreconnect - try get data from provider if an error is detected - try with cycle in selected time while data are not ok"
msgstr "Automatikus újracsatlakozás: hiba esetén a kiválasztott időközönként próbálja újra lekérni az adatokat a szolgáltatótól, amíg azok helyesek nem lesznek"

msgid "Display forecast for today and next 3 days"
msgstr "A mai és a következő 3 nap előrejelzésének megjelenítése"

msgid "Display forecast for yesterday, today and next 3 days"
msgstr "A tegnapi, a mai és a következő 3 nap előrejelzésének megjelenítése"

msgid "High temperature appear in Autocolor"
msgstr "A legmagasabb hőmérséklet automatikus színnel jelenik meg"

msgid "High temperature appear in selected color"
msgstr "A legmagasabb hőmérséklet a kiválasztott színnel jelenik meg"

msgid "Low temperature appear in Autocolor"
msgstr "A legalacsonyabb hőmérséklet automatikus színnel jelenik meg"

msgid "Low temperature appear in selected color"
msgstr "A legalacsonyabb hőmérséklet a kiválasztott színnel jelenik meg"

msgid "Cold/warm temperature appears in selected color (Cold/Warm color)"
msgstr "A hideg/meleg hőmérséklet a kiválasztott színnel jelenik meg (hideg/meleg szín)"

msgid "Cold temperature is higher as settings of \"Cold temperature\" or/and Warm temperature is lower as \"Warm temperature\""
msgstr "A hideg hőmérséklet magasabb, mint a \"Cold temperature\" beállítás és/vagy a meleg hőmérséklet alacsonyabb, mint a \"Warm temperature\" beállítás"

msgid "Warm temperature limit range: 15-40"
msgstr "Meleg hőmérséklet határérték-tartománya: 15–40"

msgid "Cold temperature limit range: 1-14"
msgstr "Hideg hőmérséklet határérték-tartománya: 1–14"

msgid "Warm temperature limit range: 58-104"
msgstr "Meleg hőmérséklet határérték-tartománya: 58–104"

msgid "Cold temperature limit range: 33-57"
msgstr "Hideg hőmérséklet határérték-tartománya: 33–57"

msgid "HDD/SSD detected by kernel as device"
msgstr "A kernel által eszközként felismert HDD/SSD"

msgid "Path to all required directories like picon, piconProv and more."
msgstr "A szükséges mappák (picon, piconProv stb.) elérési útja"

msgid "User defined path to all required directories like picon, piconProv and more."
