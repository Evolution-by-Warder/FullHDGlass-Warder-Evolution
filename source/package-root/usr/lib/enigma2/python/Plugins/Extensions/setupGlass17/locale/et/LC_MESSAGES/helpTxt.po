msgstr "Külm temperatuur ületab seadet \"Cold temperature\" ja/või soe temperatuur jääb alla seade \"Warm temperature\""

msgid "Warm temperature limit range: 15-40"
msgstr "Sooja temperatuuri piirväärtuse vahemik: 15–40"

msgid "Cold temperature limit range: 1-14"
msgstr "Külma temperatuuri piirväärtuse vahemik: 1–14"

msgid "Warm temperature limit range: 58-104"
msgstr "Sooja temperatuuri piirväärtuse vahemik: 58–104"

msgid "Cold temperature limit range: 33-57"
msgstr "Külma temperatuuri piirväärtuse vahemik: 33–57"

