msgstr "Näita inforibal \"Temperature HDD/SSD\" teavet"

msgid "Do not display selected special info \"extensions\" in main menu"
msgstr "Ära näita peamenüüs valitud \"extensions\" eriteavet"

msgid "Display selected special info \"extensions\" in main menu"
msgstr "Näita peamenüüs valitud \"extensions\" eriteavet"

