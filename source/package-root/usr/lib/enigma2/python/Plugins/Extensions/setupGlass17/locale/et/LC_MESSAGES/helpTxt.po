msgstr "Näita ainult kanali nime"

msgid "Show number and channel name"
msgstr "Näita kanali numbrit ja nime"

msgid "Show satellite position and channel name"
msgstr "Näita satelliidipositsiooni ja kanali nime"

msgid "Show number, satellite position and channel name"
msgstr "Näita kanali numbrit, satelliidipositsiooni ja nime"

msgid "None info about \"Provider\" in infobar"
msgstr "Ära näita inforibal \"Provider\" teavet"

msgid "Show info about \"Provider\" in infobar"
msgstr "Näita inforibal \"Provider\" teavet"

