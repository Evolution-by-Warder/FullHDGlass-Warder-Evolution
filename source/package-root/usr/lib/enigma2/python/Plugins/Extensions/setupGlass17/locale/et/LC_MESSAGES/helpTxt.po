msgstr "Näita temperatuuri failis my_city_Code.txt või city_Code.txt määratud ühikutes"

msgid "Temperature will be displayed with units defined in eWea_city_Code.txt"
msgstr "Näita temperatuuri failis eWea_city_Code.txt määratud ühikutes"

msgid "Temperature will be displayed in Celsius"
msgstr "Näita temperatuuri Celsiuse kraadides"

msgid "Temperature will be displayed in Fahrenheit"
msgstr "Näita temperatuuri Fahrenheiti kraadides"

msgid "Reconnect time for reading weather data from website in minutes"
msgstr "Veebilehelt ilmaandmete uuesti küsimise intervall minutites"

msgid "Reading weather data from OpenWeatherMap but you have to enter your API-key from registration on the website openweathermap.org (Registration and base API-key is free) and can be readed from /etc/openweathermap.api"
msgstr "Hangi ilmaandmed OpenWeatherMapist; selleks registreeru saidil openweathermap.org ja sisesta API-võti (registreerimine ja põhiline API-võti on tasuta). Võtme saab lugeda ka failist /etc/openweathermap.api"

msgid "Reading weather data from MSN website"
msgstr "Hangi ilmaandmed MSN-i veebilehelt"

msgid "\"Find a city\" is disabled"
msgstr "\"Find a city\" on välja lülitatud"

msgid "\"Find a city\" is disabled in extensions list"
msgstr "\"Find a city\" on laienduste loendis välja lülitatud"

msgid "\"Find a city\" is disabled in main menu"
msgstr "\"Find a city\" on peamenüüs välja lülitatud"

msgid "Do not try get data from provider if an error is detected"
msgstr "Tõrke tuvastamisel ära proovi teenusepakkujalt uusi andmeid küsida"

msgid "Autoreconnect - try get data from provider if an error is detected - try with cycle in selected time while data are not ok"
msgstr "Automaatne taasühendamine – tõrke korral küsi teenusepakkujalt määratud vahedega andmeid uuesti, kuni andmed on korras"

msgid "Display forecast for today and next 3 days"
msgstr "Näita tänase ja järgmise 3 päeva prognoosi"

msgid "Display forecast for yesterday, today and next 3 days"
msgstr "Näita eilse, tänase ja järgmise 3 päeva prognoosi"

msgid "High temperature appear in Autocolor"
msgstr "Kõrge temperatuur kuvatakse automaatse värviga"

msgid "High temperature appear in selected color"
msgstr "Kõrge temperatuur kuvatakse valitud värviga"

msgid "Low temperature appear in Autocolor"
msgstr "Madal temperatuur kuvatakse automaatse värviga"

msgid "Low temperature appear in selected color"
msgstr "Madal temperatuur kuvatakse valitud värviga"

msgid "Cold/warm temperature appears in selected color (Cold/Warm color)"
msgstr "Külm/soe temperatuur kuvatakse valitud värviga (külma/sooja värv)"

