#!/usr/bin/python3
# TEST95 Warder OpenWebif radio screenshot adapter.
# Native /usr/bin/grab is authoritative for TV/OSD/video/PiP/LCD.  Only an
# OpenWebif-style stdout "all" grab while the current service is RADIO is
# composited from the approved TEST93 master plus the live alpha OSD.
import os
import subprocess
import sys
import tempfile

REAL_GRAB = "/usr/bin/grab"
MASTER = "/usr/share/enigma2/hd_glass17/warder-radio-background.jpg"
MARKER = "/tmp/warder-radio-current"

def passthrough():
    os.execv(REAL_GRAB, [REAL_GRAB] + sys.argv[1:])

args = sys.argv[1:]
try:
    with open(MARKER, "r") as f:
        is_radio = f.read().strip() == "A"
except Exception:
    is_radio = False

# Scope the workaround strictly to OpenWebif's stdout full-screen capture.
if (not is_radio or "-s" not in args or "-o" in args or "-v" in args
        or "-i" in args or not os.path.isfile(MASTER)):
    passthrough()

fmt = "bmp"
quality = "95"
width = None
if "-p" in args:
    fmt = "png"
elif "-j" in args:
    fmt = "jpg"
    try:
        quality = args[args.index("-j") + 1]
    except Exception:
        pass
if "-r" in args:
    try:
        width = int(args[args.index("-r") + 1])
    except Exception:
        width = None

fd, osd = tempfile.mkstemp(prefix="warder-radio-osd-", suffix=".png", dir="/tmp")
os.close(fd)
fd, output = tempfile.mkstemp(prefix="warder-radio-out-", suffix="." + fmt, dir="/tmp")
os.close(fd)
try:
    rc = subprocess.call([REAL_GRAB, "-q", "-o", "-p", osd], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=8)
    if rc != 0 or os.path.getsize(osd) == 0:
        passthrough()
    filt = "[0:v][1:v]overlay=0:0:format=auto"
    if width and width > 0:
        filt += ",scale=%d:-2" % width
    cmd = ["ffmpeg", "-nostdin", "-y", "-loglevel", "error", "-i", MASTER, "-i", osd, "-filter_complex", filt, "-frames:v", "1"]
    if fmt == "png":
        cmd += ["-vcodec", "png", output]
    elif fmt == "jpg":
        cmd += ["-vcodec", "mjpeg", "-q:v", "2", output]
    else:
        cmd += ["-vcodec", "bmp", output]
    rc = subprocess.call(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=12)
    if rc != 0 or os.path.getsize(output) == 0:
        passthrough()
    with open(output, "rb") as image:
        sys.stdout.buffer.write(image.read())
    sys.stdout.buffer.flush()
except (subprocess.TimeoutExpired, OSError):
    passthrough()
finally:
    for path in (osd, output):
        try:
            os.unlink(path)
        except Exception:
            pass
