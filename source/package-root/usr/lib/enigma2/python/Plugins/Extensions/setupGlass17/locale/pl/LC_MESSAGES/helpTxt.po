msgstr "Temperatura zimna jest wyższa od ustawionego progu „Cold temperature” lub/i temperatura ciepła jest niższa od „Warm temperature”"

msgid "Warm temperature limit range: 15-40"
msgstr "Zakres progu temperatury ciepłej: 15–40"

msgid "Cold temperature limit range: 1-14"
msgstr "Zakres progu temperatury zimnej: 1–14"

msgid "Warm temperature limit range: 58-104"
msgstr "Zakres progu temperatury ciepłej: 58–104"

msgid "Cold temperature limit range: 33-57"
msgstr "Zakres progu temperatury zimnej: 33–57"

msgid "HDD/SSD detected by kernel as device"
msgstr "HDD/SSD wykryty przez jądro jako urządzenie"

msgid "Path to all required directories like picon, piconProv and more."
msgstr "Ścieżka do wszystkich wymaganych katalogów, np. picon, piconProv"

msgid "User defined path to all required directories like picon, piconProv and more."
msgstr "Ścieżka wybrana przez użytkownika do wymaganych katalogów, np. picon, piconProv"

