msgid "Show info about \"Provider\" in infobar"
msgstr "Pokazuj informacje o dostawcy w pasku informacji"

msgid "None info about \"Temperature and RPM\" in infobar"
msgstr "Nie pokazuj temperatury i obrotów (RPM) w pasku informacji"

