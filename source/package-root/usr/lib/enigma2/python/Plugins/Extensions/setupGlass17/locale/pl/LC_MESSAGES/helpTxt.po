msgstr "Pobieraj dane pogodowe z OpenWeatherMap. Wprowadź klucz API uzyskany podczas rejestracji na openweathermap.org (rejestracja i podstawowy klucz są bezpłatne). Klucz można też odczytać z /etc/openweathermap.api"

msgid "Reading weather data from MSN website"
msgstr "Pobieraj dane pogodowe ze strony MSN"

msgid "\"Find a city\" is disabled"
msgstr "Funkcja „Znajdź miasto” jest wyłączona"

msgid "\"Find a city\" is disabled in extensions list"
msgstr "Funkcja „Znajdź miasto” jest wyłączona na liście rozszerzeń"

msgid "\"Find a city\" is disabled in main menu"
msgstr "Funkcja „Znajdź miasto” jest wyłączona w menu głównym"

msgid "Do not try get data from provider if an error is detected"
msgstr "Nie próbuj ponownie pobierać danych od dostawcy po wykryciu błędu"

msgid "Autoreconnect - try get data from provider if an error is detected - try with cycle in selected time while data are not ok"
msgstr "Automatyczne ponawianie: po błędzie próbuj pobierać dane w wybranym odstępie, aż odpowiedź będzie prawidłowa"

msgid "Display forecast for today and next 3 days"
msgstr "Wyświetlaj prognozę na dziś i kolejne 3 dni"

msgid "Display forecast for yesterday, today and next 3 days"
msgstr "Wyświetlaj prognozę na wczoraj, dziś i kolejne 3 dni"

msgid "High temperature appear in Autocolor"
msgstr "Wyświetlaj najwyższą temperaturę kolorem automatycznym"

msgid "High temperature appear in selected color"
msgstr "Wyświetlaj najwyższą temperaturę wybranym kolorem"

msgid "Low temperature appear in Autocolor"
