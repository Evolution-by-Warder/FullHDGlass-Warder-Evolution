msgstr "Logotypy kanałów z białym tłem"

msgid "Channel logos with black background"
msgstr "Logotypy kanałów z czarnym tłem"

msgid "Channel logos for OLED display"
msgstr "Logotypy kanałów do wyświetlacza OLED"

