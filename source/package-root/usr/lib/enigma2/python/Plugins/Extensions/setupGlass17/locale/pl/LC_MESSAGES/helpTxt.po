msgid "No EPG data available"
msgstr "Brak dostępnych danych EPG"

msgid "Please wait for the reading and processing of data"
msgstr "Proszę czekać na odczyt i przetworzenie danych"

msgid "Press button \"OK\" to select favorite directory."
msgstr "Naciśnij „OK”, aby wybrać katalog ulubionych."

msgid "Autocolor - use definition from skin.xml or g17Screens.py; selected color - display with selected color"
msgstr "Kolor automatyczny — zastosuj definicję z skin.xml lub g17Screens.py; wybrany kolor — wyświetlaj w wybranym kolorze"

msgid "Channels from all satelitte positions and sk/cz terrestrial channels"
msgstr "Kanały ze wszystkich pozycji satelitarnych oraz słowackie i czeskie kanały naziemne"

