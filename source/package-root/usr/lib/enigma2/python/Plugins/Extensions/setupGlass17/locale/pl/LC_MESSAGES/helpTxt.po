msgstr "Pokazuj temperaturę HDD/SSD w pasku informacji"

msgid "Do not display selected special info \"extensions\" in main menu"
msgstr "Nie pokazuj wybranych rozszerzeń specjalnych w menu głównym"

msgid "Display selected special info \"extensions\" in main menu"
msgstr "Pokazuj wybrane rozszerzenia specjalne w menu głównym"

msgid "Temperature will be displayed with units defined in my_city_Code.txt or city_Code.txt"
msgstr "Wyświetlaj temperaturę w jednostkach określonych w my_city_Code.txt lub city_Code.txt"

msgid "Temperature will be displayed with units defined in eWea_city_Code.txt"
msgstr "Wyświetlaj temperaturę w jednostkach określonych w eWea_city_Code.txt"

msgid "Temperature will be displayed in Celsius"
msgstr "Wyświetlaj temperaturę w stopniach Celsjusza"

msgid "Temperature will be displayed in Fahrenheit"
msgstr "Wyświetlaj temperaturę w stopniach Fahrenheita"

