msgid "N/A"
msgstr "k. A."

msgid "free"
msgstr "frei"

msgid "TP info is not detected"
msgstr "TP-Informationen konnten nicht ermittelt werden"

msgid "Reference is not detected"
msgstr "Referenz konnte nicht ermittelt werden"

msgid "No EPG data available"
msgstr "Keine EPG-Daten verfügbar"

msgid "Please wait for the reading and processing of data"
msgstr "Bitte warten, während die Daten gelesen und verarbeitet werden"

msgid "Press button \"OK\" to select favorite directory."
msgstr "Drücken Sie „OK“, um das bevorzugte Verzeichnis auszuwählen."

msgid "Autocolor - use definition from skin.xml or g17Screens.py; selected color - display with selected color"
msgstr "Automatische Farbe: Definition aus skin.xml oder g17Screens.py verwenden; ausgewählte Farbe: Darstellung in der gewählten Farbe"

msgid "Channels from all satelitte positions and sk/cz terrestrial channels"
msgstr "Sender aller Satellitenpositionen sowie slowakische und tschechische terrestrische Sender"

msgid "No plugin Netatmo installed"
msgstr "Das Netatmo-Plugin ist nicht installiert"

msgid "Your API-key"
msgstr "Ihr API-Schlüssel"

msgid "The layout is selected automatically calculating by picon size in the infobar"
msgstr "Das Layout wird anhand der Picon-Größe in der Infoleiste automatisch berechnet und ausgewählt"

msgid "Measurement of current network speed is disabled"
msgstr "Die Messung der aktuellen Netzwerkgeschwindigkeit ist deaktiviert"

msgid "Measurement of current network speed is enabled and is displayed in kb/s"
msgstr "Die Messung der aktuellen Netzwerkgeschwindigkeit ist aktiviert; Anzeige in kb/s"

msgid "Measurement of current network speed is enabled and is displayed in Mb/s"
msgstr "Die Messung der aktuellen Netzwerkgeschwindigkeit ist aktiviert; Anzeige in Mb/s"

msgid "Poster is displayed if exists"
msgstr "Das Poster wird angezeigt, sofern es vorhanden ist"

msgid "Currently displayed Poster will be erased after press long \"OK\" and do not displayed back again"
msgstr "Das derzeit angezeigte Poster wird durch langes Drücken von „OK“ gelöscht und danach nicht erneut angezeigt"

msgid "Poster search from \"Internet Movie Database (IMDb)\""
msgstr "Postersuche in der Internet Movie Database (IMDb)"

msgid "Poster search from \"The Movie Database (TMDb)\""
msgstr "Postersuche in The Movie Database (TMDb)"

msgid "Poster search from \"Internet Movie Database (IMDb) if not found then search from \"The Movie Database (TMDb)\""
msgstr "Zuerst Postersuche in der Internet Movie Database (IMDb); falls erfolglos, Suche in The Movie Database (TMDb)"

msgid "Poster search is started with selected delay"
msgstr "Die Postersuche startet mit der gewählten Verzögerung"

msgid "Poster is displayed with the selected size"
msgstr "Das Poster wird in der gewählten Größe angezeigt"

msgid "ECM info is displayed from all channels - current displayed, background recording, streaming etc."
msgstr "ECM-Informationen aller Sender anzeigen, einschließlich des aktuellen Senders, Hintergrundaufnahmen und Streams"

msgid "ECM info is displayed from current channel"
msgstr "ECM-Informationen des aktuellen Senders anzeigen"

msgid "Bitrate is calculated by using included bitrate binary"
msgstr "Die Bitrate wird mit der mitgelieferten Bitrate-Binärdatei berechnet"

msgid "Bitrate is calculated by using eBitrateCalculator from plugin BitrateViewer"
msgstr "Die Bitrate wird mit eBitrateCalculator aus dem Plugin BitrateViewer berechnet"

msgid "All available stations with their modules are displayed one by one with defined switching time"
msgstr "Alle verfügbaren Stationen und ihre Module werden nacheinander mit der festgelegten Umschaltzeit angezeigt"

msgid "Info is displayed from Station selected in Netatmo plugin"
msgstr "Informationen der im Netatmo-Plugin ausgewählten Station anzeigen"

msgid "Time in seconds"
msgstr "Zeit in Sekunden"

msgid "Real tuner data are displayed"
msgstr "Tatsächliche Tunerdaten anzeigen"

msgid "Data are displayed from Transponder information"
msgstr "Daten aus den Transponderinformationen anzeigen"

msgid "Animations are disabled"
msgstr "Animationen sind deaktiviert"

msgid "Selected animations are applyied to selected objects"
msgstr "Die ausgewählten Animationen werden auf die ausgewählten Objekte angewendet"

msgid "Do not display info about HDD/SSD state"
msgstr "Keine Informationen zum HDD-/SSD-Zustand anzeigen"

msgid "HDD/SSD temperature, size and free space is displayed in EMC and Movieplayer infobar"
msgstr "Temperatur, Größe und freier Speicherplatz der HDD/SSD werden in den Infoleisten von EMC und Movieplayer angezeigt"

msgid "Last 10 searched channels are displayed only"
msgstr "Nur die letzten 10 gesuchten Sender anzeigen"

msgid "Searched channels are displayed as long list and you can browse in the list"
msgstr "Gefundene Sender in einer langen, durchblätterbaren Liste anzeigen"

msgid "Refresh time between frames of animated icon (default value is 50ms)"
msgstr "Aktualisierungsintervall zwischen den Einzelbildern einer animierten Ikone (Standard: 50 ms)"

msgid "Apply to all screens where the listbox is used"
msgstr "Auf alle Bildschirme mit Listenfeld anwenden"

msgid "Nighttime icons are replaced by daytime icons"
msgstr "Nachtsymbole werden durch Tagsymbole ersetzt"

msgid "Nighttime icons are displayed"
msgstr "Nachtsymbole werden angezeigt"

msgid "Press button \"OK\" to activate selected function"
msgstr "Drücken Sie „OK“, um die ausgewählte Funktion zu aktivieren"

msgid "Spinner will be used as default from image"
msgstr "Den Standard-Ladespinner des Images verwenden"

msgid "Spinner will be used from Full HD Glass17. Original spinner is moved to dir spinner-ori"
msgstr "Den Spinner von Full HD Glass17 verwenden; der ursprüngliche Spinner wird in das Verzeichnis spinner-ori verschoben"

msgid "EPG list will be displayed with selected font size"
msgstr "Die EPG-Liste wird mit der ausgewählten Schriftgröße angezeigt"

msgid "PIP types of channel selections are unavailable"
msgstr "Bild-in-Bild-Auswahlarten für Sender sind nicht verfügbar"

msgid "PIP types of channel selections are available but it can generate GSOD in some images"
msgstr "Bild-in-Bild-Auswahlarten für Sender sind verfügbar, können jedoch bei manchen Images einen GSOD verursachen"

msgid "Directory where is located the file: satellites.xml"
msgstr "Verzeichnis, in dem die Datei satellites.xml liegt"

msgid "Directory where will be saved actual configuration of FHDG (file: hdg17.conf)"
msgstr "Verzeichnis, in dem die aktuelle FHDG-Konfiguration (Datei hdg17.conf) gespeichert wird"

msgid "Display forecast for 5 days"
msgstr "Wettervorhersage für 5 Tage anzeigen"

msgid "Display forecast for 10 days at first 5 days after timeout of switch time display next 5 days"
msgstr "10-Tage-Vorhersage anzeigen: zunächst 5 Tage, nach Ablauf der Umschaltzeit die folgenden 5 Tage"

msgid "Appears info about sunrise, sunset of planets, sun and moon"
msgstr "Informationen über Auf- und Untergang von Planeten, Sonne und Mond anzeigen"

msgid "Sorry, help info is missing"
msgstr "Für diese Einstellung ist keine Hilfe verfügbar"

msgid "Info is displayed with defined color"
msgstr "Informationen in der festgelegten Farbe anzeigen"

msgid "Info is displayed with autoselected color"
msgstr "Informationen in automatisch ausgewählter Farbe anzeigen"

msgid "Show extra screen only"
msgstr "Nur den Zusatzbildschirm anzeigen"

msgid "None special info is selected"
msgstr "Keine speziellen Informationen ausgewählt"

msgid "Show extra infobar only"
msgstr "Nur die zusätzliche Infoleiste anzeigen"

msgid "Show side bar and extra infobar only"
msgstr "Nur Seitenleiste und zusätzliche Infoleiste anzeigen"

msgid "1 - fastest, 10 - slowest"
msgstr "1 – am schnellsten, 10 – am langsamsten"

msgid "Infobar appears immediately and disapears immediately"
msgstr "Die Infoleiste wird sofort ein- und ausgeblendet"

msgid "Infobar (dis)appears from full/defined transparency to defined(full) transparency"
msgstr "Die Infoleiste wird durch Übergang zwischen voller und festgelegter Transparenz ein- bzw. ausgeblendet"

msgid "Infobar appears immediately and disapears from defined to full transparency"
msgstr "Die Infoleiste erscheint sofort und wird beim Ausblenden von der festgelegten zur vollständigen Transparenz überblendet"

msgid "Show extra infobar and press 2xOK show User info"
msgstr "Zusätzliche Infoleiste anzeigen; zweimal „OK“ drücken, um Benutzerinformationen anzuzeigen"

msgid "Apears user info press 2x\"OK\" and disappears with extra infobar"
msgstr "Benutzerinformationen werden nach zweimaligem Drücken von „OK“ angezeigt und zusammen mit der zusätzlichen Infoleiste ausgeblendet"

msgid "Apears user info press 2x\"OK\" and disappears press \"OK\" or \"exit\""
msgstr "Benutzerinformationen werden nach zweimaligem Drücken von „OK“ angezeigt und durch „OK“ oder „Exit“ ausgeblendet"

msgid "Show actual event(EPG) only"
msgstr "Nur die aktuelle EPG-Sendung anzeigen"

msgid "Press long \">\" switch between actual and next evet(EPG)"
msgstr "Mit langem Drücken von „>“ zwischen aktueller und nächster EPG-Sendung wechseln"

msgid "Display ECM PID info with extra infobar"
msgstr "ECM-PID-Informationen zusammen mit der zusätzlichen Infoleiste anzeigen"

msgid "Show events name in infobar as static text"
msgstr "Sendungsnamen in der Infoleiste als statischen Text anzeigen"

msgid "Show events name in infobar char by char with typewritter effect"
msgstr "Sendungsnamen in der Infoleiste mit Schreibmaschineneffekt Zeichen für Zeichen anzeigen"

msgid "Show OLED design from \"image\" definition"
msgstr "OLED-Design gemäß der Definition im Image anzeigen"

msgid "Display \"Btr too high - stopped\" if realtime bitrate is higher as the set value"
msgstr "„Btr zu hoch – gestoppt“ anzeigen, wenn die Echtzeit-Bitrate den eingestellten Wert überschreitet"

msgid "Use only if in your image is keymapping set to \"standard Enigma2\""
msgstr "Nur verwenden, wenn das Tastenlayout des Images auf „Standard Enigma2“ eingestellt ist"

msgid "Use only if in your image is keymapping set to \"Neutrino keymap type\""
msgstr "Nur verwenden, wenn das Tastenlayout des Images auf „Neutrino keymap type“ eingestellt ist"

msgid "Show messages in default language - english"
msgstr "Meldungen in der Standardsprache Englisch anzeigen"

msgid "Show localized messages autodetected from active OSD setting of language"
msgstr "Lokalisierte Meldungen anhand der aktiven OSD-Sprache automatisch auswählen"

msgid "Infobar disappears after a defined timeout in system settings"
msgstr "Die Infoleiste wird nach dem in den Systemeinstellungen festgelegten Zeitlimit ausgeblendet"

msgid "Infobar activated by switching between channels disappears after a defined timeout in system settings. Infobar activated press \"OK\" appears permanently but can be cancelled press \"exit\" or \"OK\""
msgstr "Beim Senderwechsel angezeigte Infoleiste nach System-Zeitlimit ausblenden; durch „OK“ aufgerufene Infoleiste bleibt sichtbar, bis „Exit“ oder „OK“ gedrückt wird"

msgid "Infobar activated press \"OK\" appears permanently but disappears press \"exit\" or \"OK\""
msgstr "Die mit „OK“ aufgerufene Infoleiste bleibt sichtbar, bis „Exit“ oder „OK“ gedrückt wird"

msgid "Check connection to the point in internet defined by IP adress"
msgstr "Internetverbindung zu der durch eine IP-Adresse festgelegten Gegenstelle prüfen"

msgid "Wake up HDD/SSD is managing by image only"
msgstr "Das Aufwecken der HDD/SSD wird ausschließlich vom Image verwaltet"

msgid "Wake up HDD/SSD if any function cannot read requested info if HDD/SSD is sleeping"
msgstr "HDD/SSD aufwecken, wenn eine Funktion angeforderte Informationen nicht lesen kann, weil das Laufwerk schläft"

msgid "auto - autodetection of tuners presented in box; value (1-19) - display selected numbers of tuners"
msgstr "Automatisch: im Receiver erkannte Tuner anzeigen; Wert 1–19: ausgewählte Anzahl von Tunern anzeigen"

msgid "Do not display flashing icon \"R\" in infobar"
msgstr "Kein blinkendes „R“-Symbol in der Infoleiste anzeigen"

msgid "Display flashing icon \"R\" in infobar"
msgstr "Blinkendes „R“-Symbol in der Infoleiste anzeigen"

msgid "Leave memory management untouched"
msgstr "Speicherverwaltung unverändert lassen"

msgid "Detecting AC3/Dolby in all available audio tracks"
msgstr "AC3/Dolby in allen verfügbaren Tonspuren erkennen"

msgid "Detecting AC3/Dolby, Dolby Digital 5.1/2.0, DTS, AAC, Mpeg in current audio track"
msgstr "AC3/Dolby, Dolby Digital 5.1/2.0, DTS, AAC und MPEG in der aktuellen Tonspur erkennen"

msgid "Automatic memory cleaning - refresh time: 3min"
msgstr "Automatische Speicherbereinigung alle 3 Minuten"

msgid "IP Address used for network status check - available connection to the Internet"
msgstr "IP-Adresse zur Prüfung des Netzwerkstatus und der Internetverbindung"

msgid "Used to encoding.conf origin from active image"
msgstr "Die Datei encoding.conf des aktiven Images verwenden"

msgid "Used to encoding-user.conf located in /usr/share/enigma2"
msgstr "Die Datei encoding-user.conf aus /usr/share/enigma2 verwenden"

msgid "Channel selection works with standard functionality"
msgstr "Die Senderauswahl funktioniert mit dem Standardverhalten"

msgid "Press \"OK\" - activate selected channel and channel selection no appear then press \"OK\" - disappear channel selection or press \"exit\" revert on last playd channel before activating Channel selection"
msgstr "Mit „OK“ den ausgewählten Sender aktivieren, ohne die Senderauswahl zu schließen; erneutes „OK“ schließt sie. Mit „Exit“ zum vor dem Öffnen der Senderauswahl wiedergegebenen Sender zurückkehren"

msgid "Press \"OK\" to start selected item without animation"
msgstr "Mit „OK“ den ausgewählten Eintrag ohne Animation starten"

msgid "Press \"OK\" to start animation before activating selected item"
msgstr "Mit „OK“ vor dem Start des ausgewählten Eintrags eine Animation abspielen"

msgid "Show Weather for selected city in the setup"
msgstr "Wetter für die in den Einstellungen ausgewählte Stadt anzeigen"

msgid "Press \">\" show Weather for next city"
msgstr "Mit „>“ das Wetter der nächsten Stadt anzeigen"

msgid "Special info screen (activated press \"help\") disappear press \"help\""
msgstr "Den mit „Help“ geöffneten Spezialinformationsbildschirm durch erneutes Drücken von „Help“ schließen"

msgid "Special info screen (activated press \"help\") disappear automatically after 20s"
msgstr "Den mit „Help“ geöffneten Spezialinformationsbildschirm nach 20 Sekunden automatisch schließen"

msgid "Refresh time for reading ecm.info file"
msgstr "Aktualisierungsintervall für das Lesen der Datei ecm.info"

msgid "Disable autocheck of new version of the HDG"
msgstr "Automatische Prüfung auf eine neue HDG-Version deaktivieren"

msgid "Enable autocheck of new version of the HDG"
msgstr "Automatische Prüfung auf eine neue HDG-Version aktivieren"

msgid "Static text - no scrolling"
msgstr "Statischer Text ohne Bildlauf"

msgid "Roll up at end of text and stop wait selected seconds (text roll delay) then roll down back"
msgstr "Text nach oben rollen lassen, am Ende für die festgelegte Verzögerung anhalten und anschließend wieder nach unten rollen"

msgid "Roll up at end of text and stop"
msgstr "Text nach oben rollen lassen und am Ende anhalten"

