msgstr "Temperatureinheit aus my_city_Code.txt oder city_Code.txt übernehmen"

msgid "Temperature will be displayed with units defined in eWea_city_Code.txt"
msgstr "Temperatureinheit aus eWea_city_Code.txt übernehmen"

