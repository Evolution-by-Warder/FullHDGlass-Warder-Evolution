msgstr "HDD-/SSD-Temperatur in der Infoleiste anzeigen"

msgid "Do not display selected special info \"extensions\" in main menu"
msgstr "Ausgewählte spezielle Informationen unter „Erweiterungen“ nicht im Hauptmenü anzeigen"

msgid "Display selected special info \"extensions\" in main menu"
msgstr "Ausgewählte spezielle Informationen unter „Erweiterungen“ im Hauptmenü anzeigen"

