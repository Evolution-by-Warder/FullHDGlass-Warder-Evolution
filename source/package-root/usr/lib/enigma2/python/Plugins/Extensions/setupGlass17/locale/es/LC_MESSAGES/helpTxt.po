msgstr "Logotipos de satélites con fondo negro"

msgid "CA system and SoftCam logos with white background"
msgstr "Logotipos de sistemas CA y SoftCam con fondo blanco"

msgid "CA system and SoftCam logos with black background"
msgstr "Logotipos de sistemas CA y SoftCam con fondo negro"

msgid "Selected option previews in setup of skin"
msgstr "Vista previa de las opciones seleccionadas en la configuración del skin"

msgid "Extra screen previews and icon sets used in infobar"
msgstr "Vistas previas de pantallas adicionales y conjuntos de iconos utilizados en la barra de información"

msgid "Graphics used in extra screen and after download it you get more choices of Extra screen"
msgstr "Gráficos usados en pantallas adicionales; al descargarlos estarán disponibles más diseños de pantalla adicional"

msgid "Icons used in some menu types"
msgstr "Iconos utilizados en ciertos tipos de menú"

