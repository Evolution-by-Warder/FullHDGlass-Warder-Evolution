msgstr "Herramienta necesaria para extraer paquetes de picons"

msgid "Provider logos with transparent background"
msgstr "Logotipos de proveedores con fondo transparente"

msgid "Satellite logos with transparent background"
msgstr "Logotipos de satélites con fondo transparente"

msgid "Channelselection icons with transparent background used in some Channelselecion types"
msgstr "Iconos de selección de canales con fondo transparente, utilizados en algunos modos de selección"

