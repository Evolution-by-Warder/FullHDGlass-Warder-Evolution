msgstr "Iconos grandes utilizados en ciertos tipos de menú"

msgid "Weather icons used in special and user info types: Weather, Weather light a Extended weather"
msgstr "Iconos meteorológicos utilizados en información especial y de usuario: Weather, Weather light y Extended weather"

msgid "piconWeather white used as second picon type in infobar if is selected"
msgstr "piconWeather blanco como segundo tipo de picon en la barra de información, si se selecciona"

msgid "piconWeather black used as second picon type in infobar if is selected"
msgstr "piconWeather negro como segundo tipo de picon en la barra de información, si se selecciona"

msgid "Animated icons will be displayed"
msgstr "Mostrar iconos animados"

msgid "Static icons will be displayed"
msgstr "Mostrar iconos estáticos"

msgid "Animated Weather icons used in: Infobar, Special, User info type Weather or Enhanced Weather "
msgstr "Iconos meteorológicos animados utilizados en la barra de información y en información especial o del usuario de tipo Weather o Enhanced Weather"

msgid "Channel logos with picture background"
msgstr "Logotipos de canales con fondo de imagen"

msgid "Package of Skylink and Freesat channels only"
msgstr "Solo el paquete de canales Skylink y Freesat"

msgid "Channel logos with transparent background"
msgstr "Logotipos de canales con fondo transparente"

