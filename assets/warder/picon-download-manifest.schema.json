{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "warder-fullhdglass-picon-download-manifest-v1",
  "title": "Warder FullHDGlass channel-picon download manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "generated_from", "packages"],
  "properties": {
    "schema": {"const": 1},
    "generated_from": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "ref"],
      "properties": {
        "repository": {"const": "Evolution-by-Warder/PiconHub-Warder-Evolution"},
        "ref": {"type": "string", "minLength": 7}
      }
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["selector_id", "family", "warder_key", "filename", "bytes", "sha256", "url"],
        "properties": {
          "selector_id": {"type": "string", "minLength": 1},
          "family": {"enum": ["channel-transparent", "channel-black", "channel-white"]},
          "warder_key": {"type": "string", "minLength": 1},
          "filename": {"type": "string", "pattern": "^[A-Za-z0-9._-]+\\.(zip|7z)$"},
          "bytes": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "url": {"type": "string", "pattern": "^https://"}
        }
      }
    }
  }
}
